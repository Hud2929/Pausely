    "By creating an account you agree to the [Terms of Service](pausely-legal:terms) and the [Privacy Policy](pausely-legal:privacy).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بإنشاء حساب، فإنك توافق على [شروط الخدمة](pausely-legal:terms) و[سياسة الخصوصية](pausely-legal:privacy)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Erstellen eines Kontos stimmen Sie den [Nutzungsbedingungen](pausely-legal:terms) und der [Datenschutzerklärung](pausely-legal:privacy) zu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al crear una cuenta aceptas los [Términos del servicio](pausely-legal:terms) y la [Política de privacidad](pausely-legal:privacy)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En créant un compte, vous acceptez les [Conditions d’utilisation](pausely-legal:terms) et la [Politique de confidentialité](pausely-legal:privacy)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを作成すると、[利用規約](pausely-legal:terms)と[プライバシーポリシー](pausely-legal:privacy)に同意したことになります。"
          }
        }
      }
    },
