        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ruhiger Hinweis, wenn der Abbuchungstag eines gekündigten Abos ohne Belastung verstreicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
