          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les reçus contiennent des données d'abonnement structurées"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "領収書に構造化されたサブスクリプション情報があります"
          }
        }
      }
    },
    "The server closed the connection.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أغلق الخادم الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Verbindung geschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor cerró la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a fermé la connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが接続を閉じました。"
          }
        }
      }
    },
    "The server sent more data than expected.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل الخادم بيانات أكثر من المتوقع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat mehr Daten gesendet als erwartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor envió más datos de lo esperado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a envoyé plus de données que prévu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーから想定より多くのデータが送信されました。"
          }
        }
      }
    },
    "The server took too long to answer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق الخادم وقتًا طويلًا للرد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat zu lange nicht geantwortet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor tardó demasiado en responder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a mis trop de temps à répondre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーの応答に時間がかかりすぎました。"
          }
        }
      }
    },
    "The server turned the connection away. Check the server name and port.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الخادم الاتصال. تحقّق من اسم الخادم والمنفذ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Verbindung abgelehnt. Überprüfen Sie Servername und Port."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor rechazó la conexión. Revisa el nombre del servidor y el puerto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a refusé la connexion. Vérifiez le nom du serveur et le port."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが接続を拒否しました。サーバー名とポートを確認してください。"
          }
        }
      }
    },
    "The sign-in response didn't match this request, so Pausely ignored it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتطابق استجابة تسجيل الدخول مع هذا الطلب، لذا تجاهلها Pausely."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldeantwort passte nicht zu dieser Anfrage, daher hat Pausely sie ignoriert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta de inicio de sesión no coincidía con esta solicitud, así que Pausely la ignoró."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse de connexion ne correspondait pas à cette demande ; Pausely l'a donc ignorée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインの応答がこのリクエストと一致しなかったため、Pauselyは無視しました。"
          }
        }
      }
    },
    "They emailed about new pricing. Check what you'll pay next billing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسلوا رسالة بشأن أسعار جديدة. تحقق مما ستدفعه في الفوترة التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben über neue Preise informiert. Prüfen Sie, was Sie bei der nächsten Abrechnung zahlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaron un correo sobre nuevos precios. Comprueba cuánto pagarás en el próximo cobro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils ont envoyé un e-mail sur de nouveaux tarifs. Vérifiez ce que vous paierez à la prochaine facturation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新料金についてメールが届いています。次回の請求額を確認してください。"
          }
        }
      }
    },
    "This provider needs an app password, not your regular password.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب هذا المزود كلمة مرور للتطبيق، وليس كلمة مرورك العادية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Anbieter braucht ein App-Passwort, nicht Ihr normales Passwort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proveedor necesita una contraseña de aplicación, no tu contraseña habitual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fournisseur exige un mot de passe d'application, pas votre mot de passe habituel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロバイダでは、通常のパスワードではなくアプリパスワードが必要です。"
          }
        }
      }
    },
    "This server doesn't allow a secure password sign-in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يسمح هذا الخادم بتسجيل دخول آمن بكلمة مرور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server erlaubt keine sichere Anmeldung mit Passwort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor no permite iniciar sesión de forma segura con contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur n'autorise pas une connexion sécurisée par mot de passe."
          }
        },
        "ja": {
