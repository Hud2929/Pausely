    "Your data is saved and will be here when you return.": {
      "comment": "A message displayed in a confirmation dialog when signing out.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Daten werden gespeichert und sind beim nächsten Besuch wieder da."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus datos están guardados y estarán aquí cuando regrese."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données sont sauvegardées et seront là à votre retour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データが保存され、戻ってきたときもここにあります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ بياناتك وستكون هنا عندما تعود."
          }
        }
      }
    },
    "That date is in the future. Please check your date of birth.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا التاريخ في المستقبل. يرجى التحقق من تاريخ ميلادك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Datum liegt in der Zukunft. Bitte prüfen Sie Ihr Geburtsdatum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa fecha está en el futuro. Revisa tu fecha de nacimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette date est dans le futur. Veuillez vérifier votre date de naissance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その日付は未来の日付です。生年月日をご確認ください。"
          }
        }
      }
    },
    "We only use this to check eligibility. Your date of birth is not saved. We keep a record that you confirmed you are %lld+.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نستخدم هذا فقط للتحقق من الأهلية. لا يتم حفظ تاريخ ميلادك. نحتفظ بسجل يفيد بأنك أكدت أن عمرك %lld عامًا أو أكثر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir verwenden dies nur zur Prüfung der Berechtigung. Ihr Geburtsdatum wird nicht gespeichert. Wir speichern nur, dass Sie bestätigt haben, mindestens %lld Jahre alt zu sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lo usamos para comprobar que cumples los requisitos. No guardamos tu fecha de nacimiento. Guardamos un registro de que confirmaste tener %lld años o más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous l'utilisons uniquement pour vérifier votre éligibilité. Votre date de naissance n'est pas enregistrée. Nous conservons une trace de votre confirmation d'avoir %lld ans ou plus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用資格の確認にのみ使用します。生年月日は保存されません。%lld歳以上であることを確認した記録のみを保持します。"
          }
        }
      }
    },
