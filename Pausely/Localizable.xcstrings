    "You cancel on %@'s own site: sign in, then look under account or billing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم الإلغاء على موقع %@ نفسه: سجّل الدخول ثم ابحث في إعدادات الحساب أو الفوترة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekündigt wird auf der Website von %@: Melden Sie sich an und sehen Sie unter Konto oder Abrechnung nach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cancela en el sitio de %@: inicia sesión y busca en los ajustes de cuenta o facturación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La résiliation se fait sur le site de %@ : connectez-vous, puis regardez dans les réglages du compte ou de la facturation."
          }
        },
        "ja": {
