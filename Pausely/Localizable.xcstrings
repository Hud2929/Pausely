    "Nothing on your list matches these choices.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء في قائمتك يطابق هذه الخيارات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
