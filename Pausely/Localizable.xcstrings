          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "領収書に定期的に更新されると記載されています"
          }
        }
      }
    },
    "The receipts carry structured subscription data": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحمل الإيصالات بيانات اشتراك منظمة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
