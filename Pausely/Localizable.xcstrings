    "No more reminders about this charge. We'll ask again before %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا مزيد من التذكيرات لهذه الدفعة. سنسألك مجددًا قبل %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Erinnerungen mehr zu dieser Abbuchung. Wir fragen vor dem %@ erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No habrá más recordatorios de este cobro. Te volveremos a preguntar antes del %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de rappels pour ce prélèvement. Nous vous redemanderons avant le %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この請求についての通知は終了します。%@の前にまたお尋ねします。"
          }
        }
      }
    },
    "No more reminders about this charge.": {
      "localizations": {
        "ar": {
