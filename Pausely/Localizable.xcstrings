        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は既知のサブスクリプションサービスです"
          }
        }
      }
    },
    "%@ is already connected.": {
      "localizations": {
        "ar": {
          "stringUnit": {
