          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索を完了できませんでした。"
          }
        }
      }
    },
    "Connect and search": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال وبحث"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden und suchen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar y buscar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecter et rechercher"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続して検索"
          }
        }
      }
    },
    "Pausely only reads. It opens your mailbox read-only and never marks anything as read. The app password stays in this iPhone's Keychain; you can remove it at your provider whenever you like.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely يقرأ فقط. يفتح صندوق بريدك للقراءة فقط ولا يضع علامة «مقروء» على أي رسالة. تبقى كلمة مرور التطبيق في سلسلة المفاتيح على هذا الـ iPhone، ويمكنك حذفها لدى مزوّدك متى شئت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely liest nur. Es öffnet Ihr Postfach schreibgeschützt und markiert nie etwas als gelesen. Das App-Passwort bleibt im Schlüsselbund dieses iPhones; Sie können es jederzeit bei Ihrem Anbieter entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely solo lee. Abre tu buzón en modo de solo lectura y nunca marca nada como leído. La contraseña de aplicación se queda en el llavero de este iPhone; puedes eliminarla en tu proveedor cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely ne fait que lire. Il ouvre votre boîte en lecture seule et ne marque jamais rien comme lu. Le mot de passe d’application reste dans le trousseau de cet iPhone ; vous pouvez le supprimer chez votre fournisseur quand vous voulez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauselyは読み取るだけです。メールボックスを読み取り専用で開き、既読にすることもありません。アプリパスワードはこのiPhoneのキーチェーンに保存され、いつでもプロバイダ側で削除できます。"
          }
        }
      }
    },
    "Connect %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربط %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verbinden"
          }
        },
        "es": {
