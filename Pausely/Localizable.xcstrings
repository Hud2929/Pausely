    "Cancelled %@ · %lld of %lld charges avoided so far": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُلغي في %1$@ · تم تجنب %2$lld من %3$lld دفعات حتى الآن"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekündigt am %1$@ · bisher %2$lld von %3$lld Abbuchungen vermieden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
