    "That's the password this account already has. Choose a different one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه هي كلمة المرور الحالية لهذا الحساب. اختر كلمة مختلفة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Passwort hat das Konto bereits. Wählen Sie ein anderes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa es la contraseña que ya tiene esta cuenta. Elige otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est déjà le mot de passe de ce compte. Choisissez-en un autre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントで現在使われているパスワードです。別のパスワードを選んでください。"
          }
        }
      }
    },
    "The password couldn't be saved. Check your connection and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ كلمة المرور. تحقّق من اتصالك وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort konnte nicht gespeichert werden. Prüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la contraseña. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe n’a pas pu être enregistré. Vérifiez votre connexion et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードを保存できませんでした。通信状況を確認して、もう一度お試しください。"
          }
        }
      }
    },
    "That link has expired or was already used. Ask for a new one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية هذا الرابط أو سبق استخدامه. اطلب رابطًا جديدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link ist abgelaufen oder wurde schon verwendet. Fordern Sie einen neuen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese enlace ha caducado o ya se usó. Pide uno nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien a expiré ou a déjà été utilisé. Demandez-en un nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクは期限切れか、すでに使用されています。新しいものをリクエストしてください。"
          }
        }
      }
    },
    "This email hasn't been confirmed yet. Create the account again to get a new code.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تأكيد هذا البريد بعد. أنشئ الحساب مرة أخرى للحصول على رمز جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese E-Mail-Adresse wurde noch nicht bestätigt. Erstellen Sie das Konto erneut, um einen neuen Code zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este correo aún no se ha confirmado. Vuelve a crear la cuenta para recibir un código nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse e-mail n’a pas encore été confirmée. Créez à nouveau le compte pour recevoir un nouveau code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメールアドレスはまだ確認されていません。もう一度アカウントを作成して、新しいコードを受け取ってください。"
          }
        }
      }
    },
    "That email and password don't match an account. Check them, or reset your password.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البريد وكلمة المرور لا يطابقان أي حساب. تحقّق منهما أو أعد تعيين كلمة المرور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese E-Mail-Adresse und dieses Passwort passen zu keinem Konto. Prüfen Sie beides oder setzen Sie Ihr Passwort zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese correo y esa contraseña no coinciden con ninguna cuenta. Revísalos o restablece tu contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse e-mail et ce mot de passe ne correspondent à aucun compte. Vérifiez-les ou réinitialisez votre mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメールアドレスとパスワードに一致するアカウントがありません。確認するか、パスワードを再設定してください。"
          }
        }
      }
    },
    "Confirm your age before creating an account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد عمرك قبل إنشاء حساب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen Sie Ihr Alter, bevor Sie ein Konto erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma tu edad antes de crear una cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez votre âge avant de créer un compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを作成する前に年齢を確認してください。"
          }
        }
      }
    },
    "Sign in with Apple didn't finish. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل تسجيل الدخول عبر Apple. حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung mit Apple wurde nicht abgeschlossen. Versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se completó el inicio de sesión con Apple. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion avec Apple n’a pas abouti. Réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleでのサインインが完了しませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "Create your account": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ حسابك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto erstellen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea tu cuenta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez votre compte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを作成"
          }
        }
      }
    },
    "Your list is saved to your account, so it's still there if you change phones.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ قائمتك في حسابك، فتبقى معك إذا غيّرت هاتفك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Liste wird in Ihrem Konto gespeichert und ist auch nach einem Handywechsel noch da."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu lista se guarda en tu cuenta, así que seguirá ahí si cambias de teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre liste est enregistrée dans votre compte : vous la retrouvez si vous changez de téléphone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストはアカウントに保存されるので、機種変更しても引き継げます。"
          }
        }
      }
    },
