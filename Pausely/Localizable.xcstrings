          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に登録"
          }
        }
      }
    },
    "No cancellation email found. This store doesn't email a receipt for each renewal, so it is probably still running.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على رسالة إلغاء. هذا المتجر لا يرسل إيصالًا عند كل تجديد، لذا يُرجَّح أن الاشتراك ما زال ساريًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Kündigungs-E-Mail gefunden. Dieser Store schickt nicht für jede Verlängerung einen Beleg, das Abo läuft also wahrscheinlich noch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún correo de cancelación. Esta tienda no envía un recibo por cada renovación, así que probablemente sigue activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun e-mail d’annulation trouvé. Cette boutique n’envoie pas de reçu à chaque renouvellement : l’abonnement est donc probablement toujours en cours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解約メールは見つかりませんでした。このストアは更新のたびに領収書を送らないため、おそらく継続中です。"
          }
        }
      }
    },
    "Last charged %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر خصم في %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt abgebucht am %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Último cargo: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernier prélèvement : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終請求日: %@"
          }
        }
      }
    },
    "Each one now shows its next charge on Home.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر الآن موعد الخصم التالي لكل منها في الصفحة الرئيسية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für jedes sehen Sie jetzt die nächste Abbuchung auf der Startseite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora cada una muestra su próximo cargo en Inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacun affiche désormais son prochain prélèvement dans l’Accueil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それぞれの次回請求日がホームに表示されます。"
          }
        }
      }
    },
    "Pausely reads your receipts on this iPhone": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ Pausely إيصالاتك على هذا الـ iPhone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely liest Ihre Belege auf diesem iPhone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely lee tus recibos en este iPhone"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely lit vos reçus sur cet iPhone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauselyがこの iPhone 上で領収書を読み取ります"
          }
        }
      }
    },
    "A file of your subscriptions that you can save or send anywhere.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف باشتراكاتك يمكنك حفظه أو إرساله إلى أي مكان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Datei mit Ihren Abos, die Sie überall speichern oder versenden können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo con tus suscripciones que puedes guardar o enviar a donde quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier de vos abonnements, à enregistrer ou à envoyer où vous voulez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクの一覧をファイルにして、好きな場所に保存・送信できます。"
          }
        }
      }
    },
    "A page with a summary and a table, for printing or sharing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحة تتضمن ملخصًا وجدولًا، للطباعة أو المشاركة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Seite mit Übersicht und Tabelle, zum Drucken oder Teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una página con un resumen y una tabla, para imprimir o compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une page avec un résumé et un tableau, à imprimer ou à partager."
          }
        },
        "ja": {
          "stringUnit": {
