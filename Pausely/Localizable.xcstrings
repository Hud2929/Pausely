                "stringUnit": {
                  "state": "translated",
                  "value": "Haz una captura de Suscripciones de Apple o de los cargos recurrentes de tu banco. Pausely la lee en este iPad y nunca sube la imagen."
                }
              },
              "other": {
                "stringUnit": {
