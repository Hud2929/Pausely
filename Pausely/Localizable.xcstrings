    "iOS app only — Screen Time tracks time spent in the iPhone app, not web or desktop usage. This subscription must have an iOS app installed on your device.": {
      "comment": "A disclaimer for Screen Time usage data.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur iOS-App — Bildschirmzeit verfolgt die im iPhone-App verbrachte Zeit, nicht Web- oder Desktop-Nutzung. Diese Abonnement muss eine iOS-App auf Ihrem Gerät installiert haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo app de iOS — Tiempo de pantalla rastrea el tiempo en la app de iPhone, no el uso web o de escritorio. Esta suscripción debe tener una app de iOS instalada en su dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Application iOS uniquement — Le Temps d'écran suit le temps passé dans l'application iPhone, pas l'utilisation web ou de bureau. Cet abonnement doit avoir une application iOS installée sur votre appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSアプリのみ — スクリーンタイムはiPhoneアプリでの時間を追跡し、ウェブやデスクトップは対象外です。このサブスクリプションにはiOSアプリのインストールが必要です。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق iOS فقط — يتتبع وقت الشاشة الوقت المقضي في تطبيق iPhone، وليس الاستخدام عبر الويب أو سطح المكتب. يجب أن يكون لهذا الاشتراك تطبيق iOS مثبت على جهازك."
          }
        }
      }
    },
