    "One charge so far; a second would confirm it": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسم واحد حتى الآن؛ رسم ثانٍ يؤكده"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisher eine Abbuchung; eine zweite würde es bestätigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cargo hasta ahora; un segundo lo confirmaría"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un prélèvement pour l’instant ; un deuxième le confirmerait"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまでの請求は1回。2回目があれば確定します"
          }
        }
      }
    },
    "One search reads at most %lld possible receipts, newest first; older ones weren't read.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ البحث الواحد إيصالات محتملة حتى %lld، الأحدث أولًا؛ ولم تُقرأ الأقدم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Suche liest höchstens %lld mögliche Belege, die neuesten zuerst; ältere wurden nicht gelesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una búsqueda lee como máximo %lld posibles recibos, los más recientes primero; los más antiguos no se leyeron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une recherche lit au plus %lld reçus possibles, les plus récents d’abord ; les plus anciens n’ont pas été lus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回の検索で読むのは、新しい順に最大%lld件の領収書候補です。それより古いものは読んでいません。"
          }
        }
      }
    },
