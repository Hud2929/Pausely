            "value": "Heute ist der Verlängerungstag – kündigen Sie sofort, falls noch nicht abgebucht wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy es el día de renovación: cancela ahora mismo si todavía no se ha cobrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est le jour du renouvellement : résiliez tout de suite si le prélèvement n’a pas encore eu lieu."
          }
