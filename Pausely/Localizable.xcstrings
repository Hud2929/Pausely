    "Please cancel my %@ subscription (%@) effective immediately, and turn off auto-renewal so no further charges are billed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى إلغاء اشتراكي في %1$@ (%2$@) فورًا، وإيقاف التجديد التلقائي حتى لا يتم خصم أي مبالغ أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte kündigen Sie mein %1$@-Abo (%2$@) ab sofort und deaktivieren Sie die automatische Verlängerung, damit keine weiteren Abbuchungen erfolgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, cancelen mi suscripción de %1$@ (%2$@) con efecto inmediato y desactiven la renovación automática para evitar futuros cobros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci de résilier mon abonnement %1$@ (%2$@) dès maintenant et de désactiver le renouvellement automatique afin qu’aucun autre prélèvement n’ait lieu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在契約中の%1$@のサブスク（%2$@）について、即時解約および自動更新の停止をお願いいたします。"
          }
        }
      }
    },
    "Please confirm once the cancellation and refund have been processed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى التأكيد فور إتمام الإلغاء واسترداد المبلغ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte bestätigen Sie, sobald Kündigung und Erstattung abgeschlossen sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, confirmen cuando se hayan procesado la cancelación y el reembolso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci de me confirmer une fois la résiliation et le remboursement effectués."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解約と返金の手続きが完了しましたらご連絡をお願いいたします。"
          }
        }
      }
    },
    "Please reply with written confirmation once my subscription has been cancelled.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى الرد بتأكيد كتابي فور إلغاء اشتراكي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte senden Sie mir eine schriftliche Bestätigung, sobald mein Abo gekündigt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, respondan con confirmación por escrito una vez cancelada mi suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci de me répondre par une confirmation écrite dès que mon abonnement est résilié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解約が完了しましたら、メールにてご返信いただけますと幸いです。"
          }
        }
      }
    },
    "Polite request for a recent unwanted charge": {
