    "Stopped early, so some emails weren't read. Search again to read them all.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُوقف مبكرًا، فلم تُقرأ بعض الرسائل. ابحث مجددًا لقراءتها كلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Früh beendet, daher wurden einige E-Mails nicht gelesen. Suchen Sie erneut, um alle zu lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detuvo antes de tiempo, así que algunos correos no se leyeron. Busca de nuevo para leerlos todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtée tôt : certains e-mails n’ont pas été lus. Relancez la recherche pour tout lire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "途中で止めたため、読んでいないメールがあります。すべて読むにはもう一度検索してください。"
          }
        }
      }
    },
