    },
    "Only renewal and free-trial alerts — change anytime in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنبيهات التجديد والتجارب المجانية فقط — يمكنك تغيير ذلك في أي وقت من الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Hinweise zu Verlängerungen und Testphasen — jederzeit in den Einstellungen änderbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo avisos de renovación y pruebas gratis — cámbialo cuando quieras en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement les rappels de renouvellement et d’essais gratuits — modifiable dans Réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新と無料トライアルの通知のみ。設定からいつでも変更できます。"
          }
        }
      }
    },
    "Orders Home and Insights around what you want Pausely to catch first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرتّب الصفحة الرئيسية والتحليلات وفق ما تريد أن يرصدَه Pausely أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnet Startseite und Einblicke danach, worauf Pausely zuerst achten soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena Inicio e Información según lo que quieres que Pausely detecte primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Organise l’accueil et les analyses selon ce que Pausely doit repérer en premier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初にチェックしたい内容に合わせてホームと分析の並び順を整えます。"
          }
        }
      }
    },
    "Renews at %@ unless you cancel at least 24 hours before renewal in Settings › Subscriptions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجدد مقابل %@ ما لم تقم بالإلغاء قبل موعد التجديد بأربع وعشرين ساعة على الأقل في الإعدادات › الاشتراكات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich für %@, sofern Sie nicht mindestens 24 Stunden vor der Verlängerung in Einstellungen › Abonnements kündigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva por %@ salvo que canceles al menos 24 horas antes de la renovación en Ajustes › Suscripciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renouvelle à %@ sauf résiliation au moins 24 heures avant le renouvellement dans Réglages › Abonnements."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新の24時間前までに「設定」›「サブスクリプション」から解約しない限り、%@で自動更新されます。"
          }
        }
      }
    },
    "Rotate your streaming services one at a time in Pause Plan.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدّل بين خدمات البث واحدة تلو الأخرى عبر Pause Plan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechseln Sie Ihre Streaming-Dienste im Pause Plan einzeln ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rota tus servicios de streaming de uno en uno en Pause Plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternez vos services de streaming un par un dans Pause Plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止プランでストリーミングサービスを1つずつローテーションできます。"
          }
        }
      }
    },
    "Shapes your Home screen, Insights, and plan. Change anytime in Settings.": {
      "localizations": {
        "ar": {
