    "Available once you sign in. In local-only mode, nothing is sent to Pausely's servers.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متاح بعد تسجيل الدخول. في الوضع المحلي فقط، لا يُرسل أي شيء إلى خوادم Pausely."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfügbar, sobald Sie angemeldet sind. Im lokalen Modus wird nichts an die Server von Pausely gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible al iniciar sesión. En el modo solo local, nada se envía a los servidores de Pausely."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible une fois connecté. En mode local uniquement, rien n’est envoyé aux serveurs de Pausely."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインすると使えます。ローカル専用モードでは、Pauselyのサーバーには何も送信されません。"
          }
        }
      }
    },
