    "Receipts are read on this iPhone. A few facts of each charge are kept (who charged, how much, when, how often), never the email itself.": {
      "localizations": {
        "ar": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تُقرأ الإيصالات على هذا الـ iPad. تُحفظ بضع معلومات عن كل خصم (من خصم، وكم، ومتى، وكل كم مرة)، ولا تُحفظ الرسالة نفسها أبدًا."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تُقرأ الإيصالات على هذا الـ iPhone. تُحفظ بضع معلومات عن كل خصم (من خصم، وكم، ومتى، وكل كم مرة)، ولا تُحفظ الرسالة نفسها أبدًا."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Belege werden auf diesem iPad gelesen. Von jeder Abbuchung bleiben nur wenige Angaben (wer, wie viel, wann, wie oft), nie die E-Mail selbst."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Belege werden auf diesem iPhone gelesen. Von jeder Abbuchung bleiben nur wenige Angaben (wer, wie viel, wann, wie oft), nie die E-Mail selbst."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Receipts are read on this iPad. A few facts of each charge are kept (who charged, how much, when, how often), never the email itself."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Receipts are read on this iPhone. A few facts of each charge are kept (who charged, how much, when, how often), never the email itself."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Los recibos se leen en este iPad. De cada cargo se guardan unos pocos datos (quién, cuánto, cuándo y cada cuánto), nunca el correo en sí."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Los recibos se leen en este iPhone. De cada cargo se guardan unos pocos datos (quién, cuánto, cuándo y cada cuánto), nunca el correo en sí."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les reçus sont lus sur cet iPad. De chaque prélèvement, seules quelques informations sont gardées (qui, combien, quand, à quelle fréquence), jamais l'e-mail lui-même."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les reçus sont lus sur cet iPhone. De chaque prélèvement, seules quelques informations sont gardées (qui, combien, quand, à quelle fréquence), jamais l'e-mail lui-même."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "領収書はこのiPad上で読み取られます。各請求について残るのはいくつかの事実(請求元、金額、日付、頻度)だけで、メール自体は保存されません。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "領収書はこのiPhone上で読み取られます。各請求について残るのはいくつかの事実(請求元、金額、日付、頻度)だけで、メール自体は保存されません。"
                }
              }
            }
          }
        }
