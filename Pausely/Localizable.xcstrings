            "value": "毎回同じ金額（%@）"
          }
        }
      }
    },
    "Saved on this iPhone. It will sync when you're back online.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ على هذا الـ iPhone. ستتم المزامنة عند عودتك إلى الإنترنت."
          }
        },
        "de": {
          "stringUnit": {
