    "%@ didn't charge you today. Open your Savings Receipt to see what you've kept.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يخصم %@ منك اليوم. افتح إيصال التوفير لترى ما احتفظت به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat heute nichts abgebucht. Öffnen Sie Ihren Sparbeleg, um zu sehen, was Sie behalten haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no te cobró hoy. Abre tu Recibo de ahorro para ver cuánto llevas guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne vous a pas prélevé aujourd’hui. Ouvrez votre Reçu d’économies pour voir ce que vous avez gardé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は%@からの請求がありませんでした。節約レシートで合計を確認できます。"
          }
        }
      }
    },
    "2 days before and the day before a free trial starts charging": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل يومين وقبل يوم من بدء تحصيل رسوم التجربة المجانية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2 Tage vorher und am Tag bevor eine kostenlose Testphase kostenpflichtig wird"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2 días antes y el día antes de que una prueba gratis empiece a cobrarse"
          }
