          }
        }
      }
    },
    "Get a heads-up before you're charged": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على تنبيه قبل أن يتم الخصم منك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie sich vor jeder Abbuchung erinnern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe un aviso antes de que te cobren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soyez prévenu avant chaque prélèvement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "請求される前にお知らせを受け取る"
          }
        }
      }
    },
    "Turn on notifications for Pausely in Settings so renewals don't surprise you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل إشعارات Pausely من الإعدادات حتى لا تفاجئك التجديدات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie Mitteilungen für Pausely in den Einstellungen, damit Verlängerungen Sie nicht überraschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las notificaciones de Pausely en Ajustes para que las renovaciones no te tomen por sorpresa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les notifications de Pausely dans Réglages pour ne plus être surpris par les renouvellements."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新に驚かないよう、設定でPauselyの通知をオンにしてください。"
          }
        }
      }
    },
    "Pausely reminds you before each renewal so you can keep it or cancel it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يذكّرك Pausely قبل كل تجديد لتقرر الإبقاء عليه أو إلغاءه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely erinnert Sie vor jeder Verlängerung, damit Sie behalten oder kündigen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely te avisa antes de cada renovación para que decidas si mantenerla o cancelarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely vous prévient avant chaque renouvellement pour que vous puissiez le garder ou le résilier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauselyは更新のたびに事前にお知らせし、継続か解約かを選べるようにします。"
          }
        }
      }
    },
