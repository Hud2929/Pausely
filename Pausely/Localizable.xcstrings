        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles Gefundene steht bereits auf Ihrer Liste"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo encontrado ya está en tu lista"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui a été trouvé figure déjà sur votre liste"
