    "Pre-filled with your plan, charge, and written confirmation request. Unlock with Pausely Pro to read, copy, or send.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مُعبّأة مسبقًا بتفاصيل خطتك والمبلغ وطلب التأكيد الكتابي. افتحها مع Pausely Pro للقراءة أو النسخ أو الإرسال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorausgefüllt mit Ihrem Tarif, Betrag und der Bitte um schriftliche Bestätigung. Mit Pausely Pro freischalten, um zu lesen, zu kopieren oder zu senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellenado con tu plan, cargo y solicitud de confirmación por escrito. Desbloquéalo con Pausely Pro para leer, copiar o enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-rempli avec votre forfait, votre montant et une demande de confirmation écrite. Débloquez avec Pausely Pro pour lire, copier ou envoyer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラン・金額・書面での確認依頼が入力済みです。Pausely Proでロック解除して閲覧・コピー・送信できます。"
          }
        }
      }
    },
