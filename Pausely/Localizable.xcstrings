            "value": "744時間以内、60分未満で入力してください。"
          }
        }
      }
    },
    "Everything found is already on your list": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما تم العثور عليه موجود مسبقًا في قائمتك"
