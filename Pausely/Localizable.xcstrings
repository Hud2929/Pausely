    "Pausely built a request it couldn't send.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشأ Pausely طلبًا تعذّر إرساله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely hat eine Anfrage erstellt, die nicht gesendet werden konnte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely creó una solicitud que no pudo enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely a créé une requête qu'il n'a pas pu envoyer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauselyが送信できないリクエストを作成しました。"
          }
        }
      }
    },
    "Pausely only connects over an encrypted connection (IMAP with SSL/TLS, usually port 993).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتصل Pausely عبر اتصال مشفر فقط (IMAP مع SSL/TLS، عادةً المنفذ 993)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely verbindet sich nur verschlüsselt (IMAP mit SSL/TLS, meist Port 993)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely solo se conecta mediante una conexión cifrada (IMAP con SSL/TLS, normalmente el puerto 993)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely se connecte uniquement via une connexion chiffrée (IMAP avec SSL/TLS, généralement le port 993)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauselyは暗号化された接続（SSL/TLS付きIMAP、通常はポート993）でのみ接続します。"
          }
        }
      }
    },
    "Pausely reads the receipts in your inbox and finds what you pay for, including trials and price changes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ Pausely الإيصالات في بريدك ويكتشف ما تدفع مقابله، بما في ذلك الفترات التجريبية وتغيّرات الأسعار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely liest die Belege in Ihrem Postfach und findet, wofür Sie bezahlen – auch Testphasen und Preisänderungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely lee los recibos de tu bandeja de entrada y encuentra lo que pagas, incluidas pruebas gratis y cambios de precio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely lit les reçus de votre boîte mail et trouve ce que vous payez, y compris les essais et les changements de prix."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauselyは受信トレイの領収書を読み取り、無料トライアルや価格変更も含めて、支払っているものを見つけます。"
          }
        }
      }
    },
    "Pausely stopped because a reply came from an unexpected server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف Pausely لأن ردًا جاء من خادم غير متوقع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely hat abgebrochen, weil eine Antwort von einem unerwarteten Server kam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely se detuvo porque llegó una respuesta de un servidor inesperado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely s'est arrêté car une réponse provenait d'un serveur inattendu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "想定外のサーバーから応答があったため、Pauselyは処理を中止しました。"
          }
        }
      }
    },
