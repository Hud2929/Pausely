    "Check the exact day in the email, and cancel before it to avoid being charged.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق من اليوم الدقيق في الرسالة، وألغِ قبله لتجنب الخصم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie den genauen Tag in der E-Mail und kündigen Sie davor, damit keine Kosten anfallen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba el día exacto en el correo y cancela antes para que no te cobren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le jour exact dans l'e-mail et résiliez avant pour ne pas être prélevé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正確な日付はメールで確認し、その前に解約すれば請求されません。"
          }
        }
      }
    },
    "Check these before adding them": {
      "localizations": {
