          }
        }
      }
    },
    "The email doesn't say what it costs after the trial": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يذكر البريد الإلكتروني السعر بعد الفترة التجريبية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die E-Mail nennt keinen Preis nach der Testphase"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El correo no dice cuánto cuesta después de la prueba"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’e-mail n’indique pas le prix après l’essai"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアル後の料金はメールに書かれていません"
          }
        }
      }
    },
    "The email or app password wasn't accepted. Check both and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُقبل البريد الإلكتروني أو كلمة مرور التطبيق. تحقق منهما وحاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail-Adresse oder App-Passwort wurden nicht akzeptiert. Prüfen Sie beides und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se aceptó el correo o la contraseña de aplicación. Revisa ambos e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adresse e-mail ou le mot de passe d'application n'a pas été accepté. Vérifiez les deux et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスまたはアプリパスワードが受け付けられませんでした。両方を確認して、もう一度お試しください。"
          }
        }
      }
    },
    "The email says it is a subscription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقول الرسالة إنه اشتراك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laut der E-Mail ist es ein Abo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El correo dice que es una suscripción"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'e-mail indique qu'il s'agit d'un abonnement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールにサブスクと記載されています"
          }
        }
      }
    },
    "The emails say it is a subscription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقول الرسائل إنه اشتراك"
          }
        },
        "de": {
