            "state": "translated",
            "value": "Pausely puede avisarte antes de que te cobren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely peut vous prévenir avant un prélèvement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
