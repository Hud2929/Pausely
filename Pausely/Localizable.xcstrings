    "Open Pausely and sign in first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Pausely وسجّل الدخول أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie zuerst Pausely und melden Sie sich an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Pausely e inicia sesión primero."
          }
        },
        "fr": {
