    },
    "Pausely counts what you avoid from its renewal day, which it didn't have, so nothing is counted for it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحسب Pausely ما تتجنبه من يوم التجديد، ولم يكن معروفًا، لذلك لا يُحسب له شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely zählt, was Sie vermeiden, ab dem Verlängerungstag. Den kannte es nicht, also wird dafür nichts gezählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely cuenta lo que evitas desde el día de renovación, que no tenía, así que no se cuenta nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely compte ce que vous évitez à partir du jour de renouvellement, qu’il n’avait pas : rien n’est donc compté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauselyは更新日から避けた請求を数えますが、更新日が不明だったため、何も数えられません。"
          }
        }
      }
    },
    "Save and mark cancelled": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حفظ وتعليمه كمُلغى"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern und als gekündigt markieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar y marcar como cancelada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer et marquer comme résilié"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存して解約済みにする"
          }
        }
      }
    },
    "Subscriptions you add stay on this iPhone, like any you type in.": {
      "localizations": {
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Subscriptions you add stay on this iPad, like any you type in."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Subscriptions you add stay on this iPhone, like any you type in."
                }
              }
            }
          }
        },
        "ar": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تبقى الاشتراكات التي تضيفها على هذا الـ iPad، مثل أي اشتراك تكتبه بنفسك."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تبقى الاشتراكات التي تضيفها على هذا الـ iPhone، مثل أي اشتراك تكتبه بنفسك."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Abos, die Sie hinzufügen, bleiben auf diesem iPad, wie alle, die Sie selbst eingeben."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Abos, die Sie hinzufügen, bleiben auf diesem iPhone, wie alle, die Sie selbst eingeben."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Las suscripciones que añadas se quedan en este iPad, como las que escribes tú."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Las suscripciones que añadas se quedan en este iPhone, como las que escribes tú."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les abonnements que vous ajoutez restent sur cet iPad, comme ceux que vous saisissez."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les abonnements que vous ajoutez restent sur cet iPhone, comme ceux que vous saisissez."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "追加したサブスクは、手入力したものと同じくこのiPadに保存されます。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "追加したサブスクは、手入力したものと同じくこのiPhoneに保存されます。"
                }
              }
            }
          }
        }
      }
    },
    "Untick one to choose another.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألغِ تحديد واحد لتختار غيره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heben Sie eine Auswahl auf, um eine andere zu wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desmarca una para elegir otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décochez-en un pour en choisir un autre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のものを選ぶには、1つ選択を外してください。"
          }
        }
      }
    },
    "Untick one to choose this instead": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألغِ تحديد واحد لتختار هذا بدلًا منه"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heben Sie eine Auswahl auf, um stattdessen diese zu wählen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desmarca una para elegir esta en su lugar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décochez-en un pour choisir celui-ci à la place"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代わりにこれを選ぶには、1つ選択を外してください"
          }
        }
      }
    },
    "When would %@ have charged next?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متى كان %@ سيخصم في المرة القادمة؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann hätte %@ als Nächstes abgebucht?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuándo habría cobrado %@ la próxima vez?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand %@ aurait-il prélevé la prochaine fois ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の次回の請求日はいつでしたか？"
          }
        }
      }
    },
    "Your Savings Receipt counts the charges you avoid from that day. It's on your bank statement or in the service's account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحسب إيصال التوفير الخصومات التي تتجنبها بدءًا من ذلك اليوم. تجد التاريخ في كشف حسابك البنكي أو في حسابك لدى الخدمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Sparbeleg zählt die vermiedenen Abbuchungen ab diesem Tag. Das Datum steht auf Ihrem Kontoauszug oder im Konto beim Dienst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Recibo de ahorro cuenta los cargos que evitas desde ese día. La fecha está en tu extracto bancario o en tu cuenta del servicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Reçu d'économies compte les prélèvements évités à partir de ce jour. La date figure sur votre relevé bancaire ou dans votre compte chez le service."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "節約レシートは、その日から避けた請求を数えます。日付は銀行の明細やサービスのアカウントで確認できます。"
          }
        }
      }
    },
    "The free plan imports one screenshot at a time. Pausely Pro reads up to %lld screenshots in one batch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخطة المجانية تستورد لقطة شاشة واحدة في كل مرة. Pausely Pro يقرأ حتى %lld لقطات دفعة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kostenlose Plan importiert einen Screenshot auf einmal. Pausely Pro liest bis zu %lld Screenshots auf einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan gratuito importa una captura a la vez. Pausely Pro lee hasta %lld capturas a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le forfait gratuit importe une capture à la fois. Pausely Pro lit jusqu’à %lld captures d’un coup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料プランは1枚ずつ読み込みます。Pausely Proは最大%lld枚をまとめて読み取れます。"
          }
        }
      }
    },
    "A bill rather than a subscription: tick it to track it": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فاتورة وليست اشتراكًا: حدّدها لتتابعها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eher eine Rechnung als ein Abo: zum Erfassen ankreuzen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una factura más que una suscripción: márcala para seguirla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une facture plutôt qu’un abonnement : cochez-la pour la suivre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクではなく請求書です。管理するにはチェックしてください"
          }
        }
      }
    },
    "Cancelled without a renewal day, so no charges could be counted: %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُلغي دون يوم تجديد، لذلك لم يُحسب أي خصم: %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Verlängerungstag gekündigt, daher konnten keine Abbuchungen gezählt werden: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelada sin día de renovación, así que no se pudo contar ningún cargo: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résilié sans jour de renouvellement, aucun prélèvement n’a donc pu être compté : %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新日がないまま解約されたため、請求を数えられませんでした：%@。"
          }
        }
      }
    },
    "Charged every 2 months, counted as half each month": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُخصم كل شهرين، ويُحسب نصفه كل شهر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 2 Monate abgebucht, als Hälfte pro Monat gezählt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cobra cada 2 meses, contado como la mitad cada mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prélevé tous les 2 mois, compté pour moitié chaque mois"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2か月ごとの請求・毎月半額として計算"
          }
        }
      }
    },
    "Kept for later": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ لوقت لاحق"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für später aufgehoben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardada para después"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardé pour plus tard"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中"
          }
        }
      }
    },
    "Nothing counted yet": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُحسب شيء بعد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts gezählt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha contado nada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est encore compté"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何も数えられていません"
          }
        }
      }
    },
    "Pause Plan keeps one streaming service on at a time: you cancel the rest, and it tells you when to switch each month, so you still see everything.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُبقي خطة الإيقاف خدمة بث واحدة نشطة في كل مرة: تُلغي أنت البقية، وتخبرك متى تبدّل كل شهر، فتشاهد كل شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pausenplan lässt immer nur einen Streamingdienst aktiv: Sie kündigen die anderen, und er sagt Ihnen jeden Monat, wann Sie wechseln, sodass Sie trotzdem alles sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Plan de Pausa mantiene activo un servicio de streaming a la vez: tú cancelas el resto y te avisa cada mes de cuándo cambiar, para que no te pierdas nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Plan de pause garde un seul service de streaming actif à la fois : vous résiliez les autres, et il vous dit chaque mois quand changer, pour tout voir quand même."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止プランでは動画配信サービスを1つずつ使います。ほかは自分で解約し、毎月の切り替え時期を知らせるので、すべて見られます。"
          }
        }
      }
    },
    "There's room for %lld of the %lld you kept for later": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك مكان لـ %1$lld من أصل %2$lld احتفظت بها لوقت لاحق"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platz für %1$lld der %2$lld, die Sie für später aufgehoben haben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay sitio para %1$lld de las %2$lld que guardaste para después"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a de la place pour %1$lld des %2$lld que vous avez gardés pour plus tard"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中の%2$lld件のうち%1$lld件を追加できます"
          }
        }
      }
    },
    "No active subscriptions found": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على اشتراكات نشطة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine aktiven Abos gefunden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron suscripciones activas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun abonnement actif trouvé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なサブスクが見つかりませんでした"
          }
        }
      }
    },
    "%@ trial ends in 2 days": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي تجربة %@ خلال يومين"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Testphase für %@ endet in 2 Tagen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba de %@ termina en 2 días"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'essai de %@ se termine dans 2 jours"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の無料トライアルはあと2日で終了します"
          }
        }
      }
    },
    "%lld of %lld selected. %lld left unwatched (about %@ a year, no reminders).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اختيار %1$lld من %2$lld. يتبقى %3$lld دون متابعة (نحو %4$@ في السنة دون تذكيرات)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld ausgewählt. %3$lld bleiben unüberwacht (etwa %4$@ im Jahr, ohne Erinnerungen)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld seleccionadas. Quedan %3$lld sin seguimiento (unos %4$@ al año, sin recordatorios)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld sur %2$lld sélectionnés. %3$lld restent sans suivi (environ %4$@ par an, sans rappels)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld件中%1$lld件を選択中。%3$lld件は未監視（年間約%4$@、リマインダーなし）。"
          }
        }
      }
    },
    "About %@ a year without reminders. Choose which %lld to watch, or go Pro for all.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحو %1$@ في السنة دون تذكيرات. اختر %2$lld لمتابعتها، أو انتقل إلى Pro لمتابعة الجميع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa %1$@ im Jahr ohne Erinnerungen. Wählen Sie, welche %2$lld Sie im Blick behalten, oder schalten Sie mit Pro alle frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos %1$@ al año sin recordatorios. Elige qué %2$lld seguir o pásate a Pro para todas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %1$@ par an sans rappels. Choisissez lesquels des %2$lld suivre, ou passez à Pro pour tous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年間約%1$@がリマインダー対象外です。監視する%2$lld件を選ぶか、Proですべて管理できます。"
          }
        }
      }
    },
    "About %@ a year without reminders. The free plan tracks %lld.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحو %1$@ في السنة دون تذكيرات. الخطة المجانية تتابع %2$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa %1$@ im Jahr ohne Erinnerungen. Die kostenlose Version verfolgt %2$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos %1$@ al año sin recordatorios. El plan gratuito sigue %2$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %1$@ par an sans rappels. L'offre gratuite en suit %2$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年間約%1$@がリマインダー対象外です。無料プランでは%2$lld件まで管理できます。"
          }
        }
      }
    },
    "Added %@ to your list. All Pausely Pro features are now unlocked.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إضافة %@ إلى قائمتك. جميع ميزات Pausely Pro مفتوحة الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde Ihrer Liste hinzugefügt. Alle Funktionen von Pausely Pro sind jetzt freigeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se añadió %@ a tu lista. Todas las funciones de Pausely Pro ya están desbloqueadas."
          }
        },
        "fr": {
