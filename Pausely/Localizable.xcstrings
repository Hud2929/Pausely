{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "%@ announced a price change": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعلنت %@ عن تغيير في السعر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat eine Preisänderung angekündigt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ anunció un cambio de precio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a annoncé un changement de prix"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が料金改定を発表しました"
          }
        }
      }
    },
    "%@ goes up to %@ at the next renewal": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيرتفع سعر %1$@ إلى %2$@ عند التجديد التالي"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ steigt bei der nächsten Verlängerung auf %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sube a %2$@ en la próxima renovación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ passe à %2$@ au prochain renouvellement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は次回の更新で%2$@に値上がりします"
          }
        }
      }
    },
    "%@ goes up to %@ on %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيرتفع سعر %1$@ إلى %2$@ في %3$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ steigt am %3$@ auf %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sube a %2$@ el %3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ passe à %2$@ le %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%3$@に%2$@に値上がりします"
          }
        }
      }
    },
    "%@ is a known subscription service": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ خدمة اشتراك معروفة"
