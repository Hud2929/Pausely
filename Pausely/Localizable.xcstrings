        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返金をリクエスト"
          }
        }
      }
    },
    "Apple couldn't take the payment for Pausely Pro. Update your payment method to keep it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتمكن Apple من تحصيل دفعة Pausely Pro. حدّث طريقة الدفع للاحتفاظ به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple konnte die Zahlung für Pausely Pro nicht einziehen. Aktualisieren Sie Ihre Zahlungsmethode, um es zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no pudo cobrar Pausely Pro. Actualiza tu método de pago para conservarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n'a pas pu prélever le paiement de Pausely Pro. Mettez à jour votre moyen de paiement pour le conserver."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleがPausely Proの支払いを処理できませんでした。継続するにはお支払い方法を更新してください。"
          }
        }
      }
    },
    "How much did you use it this month?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
