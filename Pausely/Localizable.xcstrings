    "The Pausely Promise": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وعد Pausely"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Pausely-Versprechen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La promesa de Pausely"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La promesse Pausely"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauselyの約束"
          }
        }
      }
    },
    "If you ever pay for Pausely and it doesn't save you more than it costs, it will tell you to cancel it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا دفعت مقابل Pausely ولم يوفّر لك أكثر مما يكلّف، فسيخبرك أن تلغيه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie jemals für Pausely zahlen und es Ihnen nicht mehr spart, als es kostet, sagt es Ihnen, dass Sie kündigen sollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si algún día pagas Pausely y no te ahorra más de lo que cuesta, te dirá que lo canceles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous payez un jour Pausely et qu'il ne vous fait pas économiser plus qu'il ne coûte, il vous dira de le résilier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauselyに料金を払っても料金以上の節約にならない場合は、Pausely自身が解約をおすすめします。"
          }
        }
      }
    },
    "Pausely keeps it in your list as cancelled and adds the charges you avoid to your Savings Receipt.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُبقيه Pausely في قائمتك كمُلغى ويضيف الدفعات التي تتجنبها إلى إيصال التوفير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely behält es als gekündigt in Ihrer Liste und trägt die vermiedenen Abbuchungen in Ihren Sparbeleg ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely lo deja en tu lista como cancelada y añade los cobros que evitas a tu recibo de ahorro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely le garde dans votre liste comme résilié et ajoute les prélèvements évités à votre reçu d'économies."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauselyは解約済みとしてリストに残し、回避した請求を節約レシートに記録します。"
          }
        }
      }
    },
    "Saving…": {
      "localizations": {
