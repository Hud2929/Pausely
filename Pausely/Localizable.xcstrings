    },
    "Removes it and Pausely will remember, so it won't appear again": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيله وسيتذكر Pausely ذلك حتى لا يظهر مجددًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
