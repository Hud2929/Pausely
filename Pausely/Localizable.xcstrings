            "state": "translated",
            "value": "リマインダーはオンです"
          }
        }
      }
    },
    "Pausely can warn you before you're charged.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ Pausely تنبيهك قبل أن يتم الخصم منك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
