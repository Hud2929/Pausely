    "Nothing here says it repeats": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء هنا يدل على أنه يتكرر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts hier sagt, dass es sich wiederholt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada aquí indica que se repita"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ici n’indique que cela se répète"
          }
        },
        "ja": {
