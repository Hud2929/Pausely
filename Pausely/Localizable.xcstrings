    "Your subscriptions stay as they are. Pausely goes back to its usual renewal reminders.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى اشتراكاتك كما هي. ويعود Pausely إلى تذكيرات التجديد المعتادة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Abos bleiben, wie sie sind. Pausely kehrt zu den üblichen Verlängerungserinnerungen zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus suscripciones se quedan como están. Pausely vuelve a sus recordatorios de renovación habituales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos abonnements restent tels quels. Pausely revient à ses rappels de renouvellement habituels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションはそのままです。Pauselyは通常の更新リマインダーに戻ります。"
          }
        }
      }
    },
    "Add two or more streaming services": {
      "localizations": {
        "ar": {
