    "This is a typical price. Type over it if you pay something else.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا سعر معتاد. اكتب فوقه إن كنت تدفع غير ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein üblicher Preis. Überschreiben Sie ihn, wenn Sie etwas anderes zahlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un precio habitual. Escribe encima si pagas otra cosa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est un prix habituel. Remplacez-le si vous payez autre chose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一般的な料金です。違う場合は上書きしてください。"
          }
        }
      }
    },
    "This isn't a subscription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ليس اشتراكًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein Abo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no es una suscripción"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas un abonnement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはサブスクではありません"
          }
        }
      }
    },
    "This month": {
      "localizations": {
        "ar": {
