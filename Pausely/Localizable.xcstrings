    "Enter the email you signed up with. We'll send a code to prove it's you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل البريد الذي سجّلت به. سنرسل رمزًا للتأكد من أنك صاحب الحساب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie die E-Mail-Adresse ein, mit der Sie sich registriert haben. Wir senden Ihnen einen Code, um zu bestätigen, dass Sie es sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el correo con el que te registraste. Te enviaremos un código para comprobar que eres tú."
          }
