    "Your sign-in expired. Reconnect this inbox.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية تسجيل دخولك. أعد ربط صندوق البريد هذا."
          }
        },
        "de": {
          "stringUnit": {
