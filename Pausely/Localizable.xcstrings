    "Your cancellations are on track to keep you %@ over 12 months.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاءاتك في طريقها لتوفير %@ خلال اثني عشر شهرًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Kündigungen sind auf Kurs, Ihnen in 12 Monaten %@ zu sparen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus cancelaciones van camino de ahorrarte %@ en 12 meses."
          }
        },
        "fr": {
