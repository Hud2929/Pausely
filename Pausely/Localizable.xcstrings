    "Protected on this iPhone by iOS data protection, and synced to your account when you sign in so reinstalling never loses them.": {
      "localizations": {
        "ar": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "محمية على هذا الـ iPad بحماية بيانات iOS، وتُزامَن مع حسابك عند تسجيل الدخول حتى لا تضيع عند إعادة التثبيت."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "محمية على هذا الـ iPhone بحماية بيانات iOS، وتُزامَن مع حسابك عند تسجيل الدخول حتى لا تضيع عند إعادة التثبيت."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Auf diesem iPad durch iOS-Datenschutz geschützt und bei Anmeldung mit Ihrem Konto synchronisiert, damit bei Neuinstallation nichts verloren geht."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Auf diesem iPhone durch iOS-Datenschutz geschützt und bei Anmeldung mit Ihrem Konto synchronisiert, damit bei Neuinstallation nichts verloren geht."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Protected on this iPad by iOS data protection, and synced to your account when you sign in so reinstalling never loses them."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Protected on this iPhone by iOS data protection, and synced to your account when you sign in so reinstalling never loses them."
