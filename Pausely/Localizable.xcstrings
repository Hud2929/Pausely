    "After your free trial, you'll be charged %@ unless you cancel at least 24 hours before the trial ends.": {
      "comment": "A description of the free trial period and the annual price of the Pro subscription.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der kostenlosen Testphase werden %@ berechnet, sofern Sie nicht mindestens 24 Stunden vor Ende der Testphase kündigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de tu prueba gratuita, se te cobrará %@ a menos que canceles al menos 24 horas antes de que termine la prueba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après votre essai gratuit, vous serez facturé %@ sauf si vous annulez au moins 24 heures avant la fin de l'essai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料トライアル終了後、トライアル終了24時間前までにキャンセルしない限り%@が請求されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد انتهاء فترة التجربة المجانية، سيتم خصم %@ ما لم تلغِ قبل 24 ساعة على الأقل من نهاية التجربة."
          }
        }
      }
    },
