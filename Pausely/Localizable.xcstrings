                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Faites une capture des abonnements Apple ou des paiements récurrents de votre banque. Pausely la lit sur cet iPad et n’envoie jamais l’image."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Faites une capture des abonnements Apple ou des paiements récurrents de votre banque. Pausely la lit sur cet iPhone et n’envoie jamais l’image."
                }
              }
            }
          }
        },
        "ja": {
