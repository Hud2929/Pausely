        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールサーバーからの応答：%@"
          }
        }
      }
    },
    "The mail server stopped responding.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف خادم البريد عن الاستجابة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mailserver antwortet nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de correo dejó de responder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de messagerie ne répond plus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールサーバーが応答しなくなりました。"
          }
        }
      }
    },
    "The mail server's security certificate couldn't be verified, so Pausely didn't connect.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من شهادة الأمان لخادم البريد، لذلك لم يتصل Pausely."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sicherheitszertifikat des Mailservers konnte nicht überprüft werden, daher hat Pausely keine Verbindung hergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el certificado de seguridad del servidor de correo, así que Pausely no se conectó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat de sécurité du serveur de messagerie n'a pas pu être vérifié, Pausely ne s'est donc pas connecté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールサーバーのセキュリティ証明書を確認できなかったため、Pauselyは接続しませんでした。"
          }
        }
      }
    },
    "The receipt includes structured subscription data": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتضمن الإيصال بيانات اشتراك منظمة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
