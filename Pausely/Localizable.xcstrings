    "Already kept for this charge — no more reminders until the next one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الاحتفاظ به لهذه الدفعة — لا مزيد من التذكيرات حتى الدفعة التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Abbuchung bereits behalten – keine weiteren Erinnerungen bis zur nächsten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya decidido para este cobro: no recibirás más recordatorios hasta el siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà conservé pour cette échéance : plus de rappels jusqu’à la suivante."
