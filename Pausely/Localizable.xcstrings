    "Billing period assumed monthly until a second charge confirms it": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفترض أن فترة الفوترة شهرية حتى تؤكدها عملية خصم ثانية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monatliche Abrechnung angenommen, bis eine zweite Abbuchung es bestätigt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suponemos un cobro mensual hasta que un segundo cargo lo confirme"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facturation mensuelle supposée jusqu'à ce qu'un deuxième prélèvement le confirme"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2回目の請求で確認できるまで月払いと仮定しています"
