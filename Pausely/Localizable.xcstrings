    },
    "Saved on this iPhone. It hasn't reached your account yet. Pausely will keep trying.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ على هذا الـ iPhone. لم يصل إلى حسابك بعد. سيواصل Pausely المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem iPhone gespeichert. In Ihrem Konto ist es noch nicht angekommen. Pausely versucht es weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado en este iPhone. Aún no ha llegado a tu cuenta. Pausely seguirá intentándolo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré sur cet iPhone. Ce n'est pas encore arrivé sur votre compte. Pausely continuera d'essayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneに保存しました。アカウントにはまだ届いていません。Pauselyが引き続き試みます。"
          }
        }
      }
    },
