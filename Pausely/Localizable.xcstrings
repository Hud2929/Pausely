    "Our app is not intended for users under 13 years of age. We do not knowingly collect information from children under 13.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsere App ist nicht für Benutzer unter 13 Jahren gedacht. Wir erfassen wissentlich keine Informationen von Kindern unter 13 Jahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuestra app no está destinada a usuarios menores de 13 años. No recopilamos a sabiendas información de niños menores de 13 años."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notre application n'est pas destinée aux utilisateurs de moins de 13 ans. Nous ne collectons pas sciemment d'informations sur les enfants de moins de 13 ans."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリは13歳未満のユーザーを対象としていません。13歳未満の子供から情報を意図的に収集することはありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيقنا غير مخصص للمستخدمين دون سن 13 عاماً. لا نجمع معلومات من الأطفال دون سن 13 عن علم."
          }
        }
      }
    },
    "Our support team is here for you 24/7": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unser Support-Team ist 24/7 für dich da"
