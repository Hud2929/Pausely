        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit ~ markierte Stunden sind aus Sitzungsanzahl geschätzt. Tippe ein Abo an, um genaue Minuten einzugeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas marcadas con ~ son estimadas a partir de los conteos de sesión. Toca una suscripción para ingresar minutos exactos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures marquées avec ~ sont estimées à partir du nombre de sessions. Appuyez sur un abonnement pour saisir les minutes exactes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "〜付きの時間はセッション数から推定されています。正確な分数を入力するにはサブスクリプションをタップ。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الساعات المحددة بـ ~ مقدّرة من عدد الجلسات. انقر على اشتراك لإدخال الدقائق الدقيقة."
          }
        }
      }
    },
