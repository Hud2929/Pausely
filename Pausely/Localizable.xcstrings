          }
        }
      }
    },
    "The App Store couldn't be reached. Try again in a moment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى App Store. حاول مجددًا بعد قليل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store war nicht erreichbar. Versuchen Sie es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con el App Store. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre l'App Store. Réessayez dans un instant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeに接続できませんでした。しばらくしてからもう一度お試しください。"
          }
        }
      }
    },
    "Totals that mix currencies are converted at rates from %@ and marked ≈.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحوَّل الإجماليات التي تجمع أكثر من عملة بأسعار صرف بتاريخ %@ وتُعلَّم بالعلامة ≈."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Summen mit mehreren Währungen werden zu Kursen vom %@ umgerechnet und mit ≈ gekennzeichnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los totales con varias monedas se convierten con tipos de cambio del %@ y se marcan con ≈."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les totaux qui mêlent plusieurs devises sont convertis aux taux du %@ et marqués d'un ≈."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の通貨を含む合計は%@時点のレートで換算され、≈が付きます。"
          }
        }
      }
    },
    "Earlier": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سابقًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Früher"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前"
          }
        }
      }
    },
    "%@ before, %@ now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ سابقًا، و%@ الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Früher %@, jetzt %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes %@, ahora %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avant, %@ maintenant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前は%@、現在は%@。"
          }
        }
      }
    },
    "Pausely is free for you, and your cancellations are on track to keep you %@ over 12 months. If you ever pay for it, it has to save you more than it costs.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely مجاني لك، وإلغاءاتك في طريقها لتوفير %@ خلال 12 شهرًا. إذا دفعت مقابله يومًا، فعليه أن يوفّر لك أكثر مما يكلّف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely ist für Sie kostenlos, und Ihre Kündigungen sparen Ihnen in 12 Monaten voraussichtlich %@. Wenn Sie je dafür zahlen, muss es Ihnen mehr sparen, als es kostet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely es gratis para ti, y tus cancelaciones van camino de ahorrarte %@ en 12 meses. Si algún día pagas, tendrá que ahorrarte más de lo que cuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely est gratuit pour vous, et vos résiliations devraient vous faire économiser %@ sur 12 mois. Si vous payez un jour, il devra vous faire économiser plus qu'il ne coûte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauselyは無料でご利用中で、解約により12か月で%@の節約が見込まれます。有料にした場合は、料金以上の節約が条件です。"
          }
        }
      }
    },
    "Nothing is on your Savings Receipt yet. If Pausely doesn't save you more than its %@, we'd rather you cancel it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد شيء في إيصال التوفير بعد. إذا لم يوفّر لك Pausely أكثر من %@، فنفضّل أن تلغيه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Ihrem Sparbeleg steht noch nichts. Wenn Pausely Ihnen nicht mehr als %@ spart, kündigen Sie es lieber."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu recibo de ahorro aún está vacío. Si Pausely no te ahorra más de %@, preferimos que lo canceles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre reçu d'économies est encore vide. Si Pausely ne vous fait pas économiser plus que %@, nous préférons que vous le résiliiez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "節約レシートにはまだ何もありません。Pauselyが料金の%@以上を節約できないなら、解約していただくほうが良いと考えています。"
          }
        }
      }
    },
    "Your cancellations are on track to keep you %@ over 12 months, %@× what Pausely costs. Keeping it pays.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاءاتك في طريقها لتوفير %1$@ خلال 12 شهرًا، أي %2$@× تكلفة Pausely. الإبقاء عليه مجدٍ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Kündigungen sparen Ihnen in 12 Monaten voraussichtlich %1$@, das %2$@-Fache des Preises von Pausely. Es lohnt sich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus cancelaciones van camino de ahorrarte %1$@ en 12 meses, %2$@× lo que cuesta Pausely. Merece la pena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos résiliations devraient vous faire économiser %1$@ sur 12 mois, soit %2$@× le prix de Pausely. Il est rentable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解約により12か月で%1$@の節約が見込まれ、Pauselyの料金の%2$@倍です。継続する価値があります。"
          }
        }
      }
    },
    "So far your cancellations are on track to keep you %@ over 12 months, less than Pausely's %@. We'd rather you cancel than pay for nothing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى الآن إلغاءاتك في طريقها لتوفير %1$@ خلال 12 شهرًا، أي أقل من سعر Pausely البالغ %2$@. نفضّل أن تلغيه بدلًا من الدفع بلا فائدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisher sparen Ihnen Ihre Kündigungen in 12 Monaten voraussichtlich %1$@, weniger als der Preis von Pausely von %2$@. Kündigen Sie lieber, als für nichts zu zahlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora tus cancelaciones van camino de ahorrarte %1$@ en 12 meses, menos que el precio de Pausely de %2$@. Preferimos que lo canceles a que pagues por nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l'instant, vos résiliations devraient vous faire économiser %1$@ sur 12 mois, moins que le prix de Pausely de %2$@. Nous préférons que vous résiliiez plutôt que de payer pour rien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現時点で解約による12か月の節約見込みは%1$@で、Pauselyの料金の%2$@を下回っています。無駄に支払うより、解約していただくほうが良いと考えています。"
          }
        }
      }
    },
    "Kept since you cancelled": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما وفّرته منذ الإلغاء"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit der Kündigung behalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahorrado desde que cancelaste"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardé depuis vos résiliations"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解約してから守ったお金"
          }
        }
      }
    },
    "On track for %@× what Pausely costs a year.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في طريقه ليبلغ %@× تكلفة Pausely السنوية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Voraussichtlich das %@-Fache dessen, was Pausely im Jahr kostet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Va camino de ser %@× lo que cuesta Pausely al año."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En voie d'atteindre %@× le prix annuel de Pausely."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauselyの年間料金の%@倍になる見込みです。"
          }
        }
      }
    },
    "How we count: only charges your renewal date and price say would have happened, for 12 months after you cancel. If a subscription starts again, its savings stop that day. Pausely's own subscription never counts.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف نحسب: فقط الدفعات التي يدلّ تاريخ التجديد والسعر اللذان أدخلتهما على أنها كانت ستحدث، لمدة 12 شهرًا بعد الإلغاء. إذا بدأ الاشتراك مجددًا، يتوقف حساب التوفير في ذلك اليوم. لا يُحتسب اشتراك Pausely نفسه أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So zählen wir: nur Abbuchungen, die nach Ihrem Verlängerungsdatum und Preis angefallen wären, für 12 Monate nach der Kündigung. Startet ein Abo wieder, endet seine Ersparnis an diesem Tag. Das Pausely-Abo selbst zählt nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo contamos: solo los cobros que, según tu fecha de renovación y tu precio, se habrían producido, durante 12 meses tras cancelar. Si una suscripción vuelve a empezar, su ahorro termina ese día. La suscripción de Pausely nunca cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notre calcul : uniquement les prélèvements qui auraient eu lieu d'après votre date de renouvellement et votre prix, pendant 12 mois après la résiliation. Si un abonnement reprend, ses économies s'arrêtent ce jour-là. L'abonnement Pausely ne compte jamais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算方法：入力された更新日と金額から、解約後12か月間に発生していたはずの請求だけを数えます。再開した場合はその日で節約の計上を止めます。Pausely自体のサブスクリプションは含めません。"
          }
        }
      }
    },
    "About %@ a year": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حوالي %@ في السنة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa %@ im Jahr"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos %@ al año"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %@ par an"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年間約%@"
          }
        }
      }
    },
    "If you rotate every month, at today's prices.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا بدّلت كل شهر، بأسعار اليوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie jeden Monat wechseln, zu heutigen Preisen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rotas cada mes, a los precios de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous alternez chaque mois, aux prix d'aujourd'hui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月入れ替えた場合の、現在の料金での目安です。"
          }
        }
      }
    },
    "That's about %@ a year more than you thought.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يزيد بنحو %@ في السنة عمّا ظننت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind etwa %@ im Jahr mehr, als Sie dachten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son unos %@ al año más de lo que pensabas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela fait environ %@ par an de plus que vous ne pensiez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "思っていたより年間約%@多く払っています。"
          }
        }
      }
    },
    "Netflix, Spotify…": {
