            "value": "Die Suche konnte nicht abgeschlossen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la búsqueda."
          }
        },
        "fr": {
          "stringUnit": {
