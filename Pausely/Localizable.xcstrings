    "Pausely is for people %lld and older. Enter your date of birth to continue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely مخصص لمن تبلغ أعمارهم %lld عامًا فأكثر. أدخل تاريخ ميلادك للمتابعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely ist für Personen ab %lld Jahren. Geben Sie Ihr Geburtsdatum ein, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely es para personas de %lld años o más. Introduce tu fecha de nacimiento para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely est destiné aux personnes de %lld ans et plus. Saisissez votre date de naissance pour continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauselyは%lld歳以上の方を対象としています。続行するには生年月日を入力してください。"
          }
        }
      }
    },
    "You can't use Pausely yet": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكنك استخدام Pausely بعد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können Pausely noch nicht nutzen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no puedes usar Pausely"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas encore utiliser Pausely"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだPauselyをご利用いただけません"
          }
        }
      }
    },
    "Pausely is only available to people %lld and older, so we can't create an account for you right now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely متاح فقط لمن تبلغ أعمارهم %lld عامًا فأكثر، لذا لا يمكننا إنشاء حساب لك الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely ist nur für Personen ab %lld Jahren verfügbar, daher können wir derzeit kein Konto für Sie erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely solo está disponible para personas de %lld años o más, así que ahora mismo no podemos crearte una cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely n'est disponible qu'aux personnes de %lld ans et plus, nous ne pouvons donc pas créer de compte pour vous pour le moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauselyは%lld歳以上の方のみご利用いただけるため、現在アカウントを作成できません。"
          }
        }
      }
    },
    "Reminders are off": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التذكيرات متوقفة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen sind aus"
          }
        },
