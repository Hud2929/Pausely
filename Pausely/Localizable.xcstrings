        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つかったものはすべてリストに登録済みです"
          }
        }
      }
    },
    "Free plan: %lld tracked (free limit is %lld).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخطة المجانية: تتم متابعة %1$lld (حد الخطة المجانية %2$lld)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenloser Plan: %1$lld erfasst (kostenloses Limit: %2$lld)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan gratuito: %1$lld en seguimiento (el límite gratuito es %2$lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Offre gratuite : %1$lld suivis (la limite gratuite est de %2$lld)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料プラン：%1$lld件を追跡中（無料上限は%2$lld件）。"
          }
        }
      }
    },
    "I recently noticed a charge after a %@ free trial that I did not intend to continue. I would like to cancel the plan and request a refund for this charge.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لاحظت مؤخرًا خصمًا بعد التجربة المجانية لـ %@ لم أكن أنوي متابعته. أرغب في إلغاء الخطة وطلب استرداد هذا المبلغ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe kürzlich eine Abbuchung nach einer kostenlosen Testphase für %@ bemerkt, die ich nicht fortführen wollte. Ich möchte den Tarif kündigen und eine Erstattung dieser Abbuchung beantragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace poco noté un cobro tras una prueba gratuita de %@ que no tenía intención de continuar. Me gustaría cancelar el plan y solicitar el reembolso de este cobro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai récemment constaté un prélèvement après un essai gratuit %@ que je ne souhaitais pas poursuivre. Je souhaite résilier l’offre et demander le remboursement de ce prélèvement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の無料トライアル終了後に継続する予定のない請求が発生していることに気づきました。プランを解約し、今回の請求について返金を申請したいです。"
          }
        }
      }
    },
    "I recently noticed a charge for my %@ subscription that I no longer intend to use. I would like to cancel the plan and request a refund for this charge.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لاحظت مؤخرًا خصمًا لاشتراك %@ لم أعد أنوي استخدامه. أرغب في إلغاء الخطة وطلب استرداد هذا المبلغ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe kürzlich eine Abbuchung für mein %@-Abo bemerkt, das ich nicht mehr nutzen möchte. Ich möchte das Abo kündigen und eine Erstattung dieser Abbuchung beantragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace poco noté un cobro por mi suscripción de %@ que ya no tengo intención de usar. Me gustaría cancelar el plan y solicitar el reembolso de este cobro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai récemment constaté un prélèvement pour mon abonnement %@ que je ne souhaite plus utiliser. Je souhaite résilier l’offre et demander le remboursement de ce prélèvement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後利用する予定のない%@のサブスクの請求が発生していることに気づきました。プランを解約し、今回の請求について返金を申請したいです。"
          }
        }
      }
    },
    "I turned off renewal": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقفتُ التجديد التلقائي"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe die Verlängerung deaktiviert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivé la renovación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai désactivé le renouvellement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動更新をオフにしました"
          }
        }
      }
    },
    "Its free trial ends %@ and charges %@. Cancel at least 24 hours ahead and it comes back on its turn.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي تجربته المجانية %1$@ ويُخصم %2$@. ألغِه قبل أربع وعشرين ساعة على الأقل وسيعود في دوره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kostenlose Testphase endet %1$@ und kostet dann %2$@. Kündigen Sie mindestens 24 Stunden vorher – es kommt wieder an die Reihe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su prueba gratuita termina %1$@ y cobra %2$@. Cancélala al menos 24 horas antes y volverá cuando le toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son essai gratuit se termine %1$@ puis prélève %2$@. Résiliez au moins 24 heures à l’avance et il reviendra à son tour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料トライアルは%1$@に終了し、%2$@が請求されます。24時間前までに解約すれば、次の順番で戻ってきます。"
          }
        }
      }
    },
    "Its free trial ends tomorrow and charges %@. Cancel today and it comes back on its turn.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي تجربته المجانية غدًا ويُخصم %@. ألغِه اليوم وسيعود في دوره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kostenlose Testphase endet morgen und kostet dann %@. Kündigen Sie heute – es kommt wieder an die Reihe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su prueba gratuita termina mañana y cobra %@. Cancélala hoy y volverá cuando le toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son essai gratuit se termine demain puis prélève %@. Résiliez aujourd’hui et il reviendra à son tour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料トライアルは明日終了し、%@が請求されます。今日解約すれば、次の順番で戻ってきます。"
          }
        }
      }
    },
    "Keep one streaming service on at a time, extend or switch turns live, and sync your plan across devices.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ خدمة بث واحدة مفعّلة في كل مرة، ومدّد أو بدّل الأدوار مباشرة، وزامن خطتك عبر أجهزتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie immer nur einen Streaming-Dienst aktiv, verlängern oder wechseln Sie Runden direkt und synchronisieren Sie Ihren Plan geräteübergreifend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén activo un solo servicio de streaming a la vez, amplía o cambia turnos al momento y sincroniza tu plan entre dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez un seul service de streaming actif à la fois, prolongez ou changez de tour en direct et synchronisez votre plan sur vos appareils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画配信サービスを1つずつ切り替え、その場で延長・変更し、デバイス間でプランを同期できます。"
          }
        }
      }
    },
    "My free trial ends on %@. Please confirm cancellation in writing before that date.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي تجربتي المجانية في %@. يرجى تأكيد الإلغاء كتابيًا قبل ذلك التاريخ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine kostenlose Testphase endet am %@. Bitte bestätigen Sie die Kündigung schriftlich vor diesem Datum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi prueba gratuita termina el %@. Por favor, confirma la cancelación por escrito antes de esa fecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mon essai gratuit se termine le %@. Merci de confirmer la résiliation par écrit avant cette date."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料トライアルは%@に終了します。その日までに解約完了の書面（メール）での確認をお願いします。"
          }
        }
      }
    },
    "No more subscriptions found in those screenshots.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على اشتراكات أخرى في تلك اللقطات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesen Screenshots wurden keine weiteren Abos gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron más suscripciones en esas capturas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun autre abonnement trouvé dans ces captures."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのスクリーンショットからは他にサブスクが見つかりませんでした。"
          }
        }
      }
    },
    "Nothing is on your Savings Receipt yet. Once you cancel a subscription, Pausely tracks whether it pays for itself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد شيء في إيصال التوفير بعد. بمجرد إلغاء اشتراك، يتحقق Pausely مما إذا كان يغطي تكلفته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Ihrem Sparbeleg steht noch nichts. Sobald Sie ein Abo kündigen, verfolgt Pausely, ob es sich selbst bezahlt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nada en tu Recibo de ahorro. En cuanto canceles una suscripción, Pausely comprueba si se paga solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne figure encore sur votre Reçu d’économies. Dès qu’un abonnement est résilié, Pausely vérifie s’il est rentabilisé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "節約レシートにはまだ記録がありません。サブスクを解約すると、Pauselyが元が取れているか追跡します。"
          }
        }
      }
    },
    "Notifications are allowed, but banners, Lock Screen and Notification Center are all off in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات مسموح بها، لكن الشعارات وشاشة القفل ومركز الإشعارات متوقفة كلها في الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind erlaubt, aber Banner, Sperrbildschirm und Mitteilungszentrale sind in den Einstellungen alle ausgeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están permitidas, pero los avisos, la pantalla bloqueada y el centro de notificaciones están desactivados en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont autorisées, mais les bannières, l’écran verrouillé et le centre de notifications sont tous désactivés dans Réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知は許可されていますが、バナー・ロック画面・通知センターがすべて設定でオフになっています。"
          }
        }
      }
    },
    "Open Amazon Channels": {
      "localizations": {
        "ar": {
          "stringUnit": {
