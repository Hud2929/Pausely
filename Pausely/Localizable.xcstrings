            "state": "translated",
            "value": "Apple necesita al menos 24 horas de antelación antes del %@ para no cobrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple exige un préavis d’au moins 24 heures avant le %@ pour éviter le prélèvement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "課金を防ぐには、%@の少なくとも24時間前までにAppleで解約する必要があります。"
          }
        }
      }
    },
