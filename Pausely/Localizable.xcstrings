    "See how much you could save by paying yearly instead of monthly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, wie viel du durch jährliche statt monatliche Zahlung sparen könntest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve cuánto podrías ahorrar pagando anualmente en lugar de mensualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez combien vous pourriez économiser en payant annuellement plutôt que mensuellement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月払いの代わりに年払いにすることでいくら節約できるか確認。"
