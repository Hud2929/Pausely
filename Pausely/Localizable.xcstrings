    "Stay on this iPhone, protected by iOS data protection.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى على هذا الـ iPhone، محمية بحماية البيانات في iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleiben auf diesem iPhone, geschützt durch die iOS-Datensicherheit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quedan en este iPhone, protegidos por la protección de datos de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restent sur cet iPhone, protégés par la protection des données d’iOS."
          }
