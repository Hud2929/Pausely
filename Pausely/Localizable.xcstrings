            "state": "translated",
            "value": "Les prélèvements ne sont pas réguliers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "請求の間隔が一定ではありません"
          }
        }
      }
    },
    "The connection closed.": {
      "localizations": {
