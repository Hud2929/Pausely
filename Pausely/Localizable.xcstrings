    "Check your connection and try again. If it keeps failing, email %@ and we'll delete it within 30 days.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق من اتصالك وحاول مرة أخرى. إذا استمرّ الفشل، راسل %@ وسنحذفه خلال 30 يومًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie Ihre Verbindung und versuchen Sie es erneut. Wenn es weiter fehlschlägt, schreiben Sie an %@, und wir löschen es innerhalb von 30 Tagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tu conexión e inténtalo de nuevo. Si sigue fallando, escribe a %@ y la eliminaremos en un plazo de 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion et réessayez. Si l’échec persiste, écrivez à %@ et nous le supprimerons sous 30 jours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通信状況を確認して、もう一度お試しください。それでも失敗する場合は %@ までメールでご連絡ください。30日以内に削除します。"
          }
        }
      }
    },
