    "You received a cancellation email, then a later charge of %@. Worth disputing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلقيت رسالة إلغاء، ثم خصمًا لاحقًا بقيمة %@. يستحق الاعتراض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben eine Kündigungs-E-Mail erhalten und danach eine Abbuchung von %@. Ein Widerspruch lohnt sich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibiste un correo de cancelación y luego un cargo de %@. Vale la pena reclamarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez reçu un e-mail de résiliation, puis un prélèvement de %@. Cela vaut la peine de le contester."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解約メールの後に%@の請求がありました。異議申し立てを検討してください。"
          }
        }
      }
    },
    "You told Pausely this is a subscription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخبرت Pausely أن هذا اشتراك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben Pausely gesagt, dass dies ein Abo ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dijiste a Pausely que esto es una suscripción"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez indiqué à Pausely qu'il s'agit d'un abonnement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはサブスクリプションだとPauselyに伝えました"
          }
        }
      }
    },
    "You're on an introductory price of %@. It renews at %@ unless you cancel or switch plans first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت على سعر تمهيدي قدره %1$@. سيتجدد بسعر %2$@ ما لم تُلغِ أو تغيّر خطتك قبل ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie zahlen einen Einführungspreis von %1$@. Die Verlängerung kostet %2$@, sofern Sie nicht vorher kündigen oder den Tarif wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes un precio de introducción de %1$@. Se renueva a %2$@ salvo que canceles o cambies de plan antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous bénéficiez d'un prix de lancement de %1$@. Il se renouvellera à %2$@ sauf si vous résiliez ou changez de forfait avant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在は%1$@の初回価格です。事前に解約またはプラン変更しない限り、%2$@で更新されます。"
          }
        }
      }
    },
    "Your card was declined on %@. Update it if you want to keep %@, or let it lapse if you don't.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رُفضت بطاقتك في %1$@. حدّثها إذا أردت الاحتفاظ بـ %2$@، أو اتركه ينتهي إن لم ترغب في ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Karte wurde am %1$@ abgelehnt. Aktualisieren Sie sie, wenn Sie %2$@ behalten möchten, oder lassen Sie es auslaufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechazaron tu tarjeta el %1$@. Actualízala si quieres mantener %2$@, o déjala vencer si no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre carte a été refusée le %1$@. Mettez-la à jour si vous voulez garder %2$@, sinon laissez-le expirer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@にカードが拒否されました。%2$@を続けるならカード情報を更新し、不要ならそのまま失効させてください。"
          }
        }
      }
    },
    "Your email never leaves your iPhone.": {
