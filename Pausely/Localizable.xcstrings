    "Receipts are read on this iPhone. Only the name, amount and date of each charge are kept.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقرأ الإيصالات على هذا الـ iPhone. يُحتفظ فقط باسم كل عملية خصم ومبلغها وتاريخها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belege werden auf diesem iPhone gelesen. Gespeichert werden nur Name, Betrag und Datum jeder Abbuchung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recibos se leen en este iPhone. Solo se guardan el nombre, el importe y la fecha de cada cargo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les reçus sont lus sur cet iPhone. Seuls le nom, le montant et la date de chaque prélèvement sont conservés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "領収書はこのiPhone上で読み取られます。保存されるのは各請求の名前・金額・日付だけです。"
          }
        }
      }
    },
    "Renewal reminders": {
