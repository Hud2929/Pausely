          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después cuesta %1$@ %2$@. ¿La mantienes o la cancelas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, il coûte %1$@ %2$@. Le garder ou le résilier ?"
