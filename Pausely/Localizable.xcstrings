    "Enter up to 744 hours and under 60 minutes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل حتى سبعمئة وأربع وأربعين ساعة وأقل من ستين دقيقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie höchstens 744 Stunden und weniger als 60 Minuten ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce hasta 744 horas y menos de 60 minutos."
          }
        },
        "fr": {
