    "Amount varies a lot, which looks more like orders than a plan": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتغير المبلغ كثيرًا، وهذا أقرب إلى طلبات منه إلى خطة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Betrag schwankt stark, das sieht eher nach Bestellungen als nach einem Tarif aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El importe varía mucho, lo que parece más bien pedidos que un plan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montant varie beaucoup, ce qui ressemble plus à des commandes qu'à un forfait"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額の変動が大きく、定期プランというより注文のようです"
          }
        }
      }
    },
    "An email mentions renewing or a recurring plan": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إحدى الرسائل تذكر التجديد أو خطة متكررة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine E-Mail erwähnt eine Verlängerung oder einen wiederkehrenden Tarif"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un correo menciona una renovación o un plan recurrente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un e-mail mentionne un renouvellement ou un forfait récurrent"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールに更新または定期プランの記載があります"
          }
        }
      }
    },
    "Another command is still running.": {
      "localizations": {
