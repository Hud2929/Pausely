    },
    "You cancel on %@'s own site: sign in, then look under account or billing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم الإلغاء على موقع %@ نفسه: سجّل الدخول ثم ابحث في إعدادات الحساب أو الفوترة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekündigt wird auf der Website von %@: Melden Sie sich an und sehen Sie unter Konto oder Abrechnung nach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cancela en el sitio de %@: inicia sesión y busca en los ajustes de cuenta o facturación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La résiliation se fait sur le site de %@ : connectez-vous, puis regardez dans les réglages du compte ou de la facturation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解約は%@のサイトで行います。サインインして、アカウントまたは請求の設定を確認してください。"
          }
        }
      }
    },
    "You chose %lld to track. The rest wait until you make room or go Pro.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اخترت متابعة %lld. وتبقى البقية بانتظار توفر مساحة أو الترقية إلى Pro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben %lld zum Erfassen gewählt. Der Rest wartet, bis Platz frei wird oder Sie Pro nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegiste seguir %lld. El resto espera hasta que hagas sitio o pases a Pro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez choisi d’en suivre %lld. Les autres attendent que vous fassiez de la place ou passiez à Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件を管理対象に選びました。残りは枠が空くかProにするまで待機します。"
          }
        }
      }
    },
    "You enter this yourself. Pausely doesn't read your Screen Time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت من يُدخل هذا. Pausely لا يقرأ «مدة استخدام الجهاز»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das tragen Sie selbst ein. Pausely liest Ihre Bildschirmzeit nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo introduces tú. Pausely no lee tu Tiempo de uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous le saisissez vous-même. Pausely ne lit pas votre Temps d'écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご自身で入力します。Pauselyはスクリーンタイムを読み取りません。"
          }
        }
      }
    },
