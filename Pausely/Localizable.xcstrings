    "Already on your list: %lld. Missing renewal dates were filled in from your receipts.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موجودة مسبقًا في قائمتك: %lld. تمت إضافة تواريخ التجديد الناقصة من إيصالاتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits auf Ihrer Liste: %lld. Fehlende Verlängerungsdaten wurden aus Ihren Belegen ergänzt."
          }
        },
        "es": {
          "stringUnit": {
