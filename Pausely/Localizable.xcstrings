    "Spot unused subscriptions and cancel them in seconds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتشف الاشتراكات غير المستخدمة وألغِها في ثوانٍ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finden Sie ungenutzte Abos und kündigen Sie sie in Sekunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta suscripciones sin usar y cancélalas en segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repérez les abonnements inutilisés et résiliez-les en quelques secondes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使っていないサブスクを見つけて数秒で解約できます。"
          }
        }
      }
    },
    "Spot your heaviest renewal months ahead and test cancellations side by side in Insights.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتشف أكثر الأشهر تكلفة مسبقًا وجرّب الإلغاءات جنبًا إلى جنب في التحليلات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkennen Sie Ihre teuersten Monate im Voraus und testen Sie Kündigungen nebeneinander unter Einblicke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta los meses con más renovaciones por adelantado y compara cancelaciones lado a lado en Resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repérez vos mois les plus chargés à l’avance et comparez des résiliations côte à côte dans Aperçu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分析タブで請求が重なる月を先に確認し、解約シミュレーションを並べて比較できます。"
          }
        }
      }
    },
    "Today is the renewal day — cancel right away if it hasn't charged yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اليوم هو يوم التجديد — ألغِه فورًا إذا لم يتم الخصم بعد."
          }
        },
        "de": {
