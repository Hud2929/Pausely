          }
        }
      }
    },
    "Turn on notifications in Settings for a reminder before it charges. Cancel by %@ in Settings and you pay nothing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل الإشعارات في الإعدادات لتصلك تذكيرة قبل الخصم. ألغِ قبل %@ في الإعدادات ولن تدفع شيئًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie Mitteilungen in den Einstellungen für eine Erinnerung vor der Abbuchung. Kündigen Sie bis %@ in den Einstellungen und zahlen Sie nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las notificaciones en Ajustes para recibir un recordatorio antes del cobro. Cancela antes del %@ en Ajustes y no pagas nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les notifications dans Réglages pour recevoir un rappel avant le prélèvement. Résiliez avant le %@ dans Réglages et vous ne paierez rien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "請求前のリマインダーを受け取るには「設定」で通知をオンにしてください。%@までに「設定」で解約すれば料金はかかりません。"
          }
        }
      }
    },
    "Turn on notifications so Pausely can remind you before your free trial charges.": {
      "localizations": {
        "ar": {
