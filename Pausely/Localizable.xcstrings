    },
    "Removed from this iPhone. It will sync when you're back online.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت الإزالة من هذا الـ iPhone. ستتم المزامنة عند عودتك إلى الإنترنت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von diesem iPhone entfernt. Die Synchronisierung folgt, sobald Sie wieder online sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminado de este iPhone. Se sincronizará cuando vuelvas a estar en línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimé de cet iPhone. La synchronisation se fera dès que vous serez de nouveau en ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneから削除しました。オンラインに戻ると同期されます。"
          }
        }
      }
    },
    "Removed from this iPhone. Your account still has it. Pausely will keep trying.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت الإزالة من هذا الـ iPhone. ما زال موجودًا في حسابك. سيواصل Pausely المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von diesem iPhone entfernt. In Ihrem Konto ist es noch vorhanden. Pausely versucht es weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminado de este iPhone. Tu cuenta aún lo tiene. Pausely seguirá intentándolo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimé de cet iPhone. Votre compte l'a encore. Pausely continuera d'essayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneから削除しました。アカウントにはまだ残っています。Pauselyが引き続き試みます。"
          }
        }
      }
    },
    "Same amount each time (%@)": {
      "localizations": {
