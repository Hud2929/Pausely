    "No price changes yet. When you change what %@ costs, the old price and the new one are kept here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تغييرات في السعر حتى الآن. عندما تغيّر تكلفة %@، يُحفظ السعر القديم والجديد هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Preisänderungen. Wenn Sie ändern, was %@ kostet, werden der alte und der neue Preis hier festgehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay cambios de precio. Cuando cambies lo que cuesta %@, el precio anterior y el nuevo se guardan aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun changement de prix pour l’instant. Quand vous modifiez le prix de %@, l’ancien et le nouveau sont conservés ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ価格の変更はありません。%@ の金額を変更すると、変更前と変更後の価格がここに残ります。"
          }
        }
      }
    },
    "%@ in %@, %@ now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ في %2$@، والآن %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ im %2$@, jetzt %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ en %2$@, ahora %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ en %2$@, %3$@ aujourd’hui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ は %1$@、現在は %3$@。"
          }
        }
      }
    },
    "%@ more than before": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكثر من السابق بـ %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mehr als zuvor"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ más que antes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de plus qu’avant"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前より %@ 高い"
          }
        }
      }
    },
    "%@ less than before": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقل من السابق بـ %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ weniger als zuvor"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ menos que antes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de moins qu’avant"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前より %@ 安い"
          }
        }
      }
    },
    "How long did you use %@ this month?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كم استخدمت %@ هذا الشهر؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange haben Sie %@ diesen Monat genutzt?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuánto has usado %@ este mes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de temps avez-vous utilisé %@ ce mois-ci ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月 %@ をどのくらい使いましたか？"
          }
        }
      }
    },
    "I haven't used it this month": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم أستخدمه هذا الشهر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe es diesen Monat nicht genutzt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No lo he usado este mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne l’ai pas utilisé ce mois-ci"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月は使っていません"
          }
        }
      }
    },
    "Cancel by %@ in Settings and you pay nothing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألغِ في موعد أقصاه %@ من الإعدادات ولن تدفع شيئًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kündigen Sie bis zum %@ in den Einstellungen, und Sie zahlen nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela hasta el %@ en Ajustes y no pagas nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulez au plus tard le %@ dans Réglages et vous ne payez rien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@までに「設定」で解約すれば、料金はかかりません。"
          }
        }
      }
    },
    "Renews automatically. To cancel, open Settings, tap your name, then Subscriptions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجدد تلقائيًا. للإلغاء، افتح الإعدادات، واضغط على اسمك، ثم الاشتراكات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich automatisch. Zum Kündigen öffnen Sie die Einstellungen, tippen Sie auf Ihren Namen und dann auf Abonnements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva automáticamente. Para cancelar, abre Ajustes, toca tu nombre y luego Suscripciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvellement automatique. Pour annuler, ouvrez Réglages, touchez votre nom, puis Abonnements."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動更新されます。解約するには「設定」を開き、自分の名前、「サブスクリプション」の順にタップします。"
          }
        }
      }
    },
    "This permanently deletes your account, your subscription list and your history from Pausely's servers and this iPhone. It doesn't cancel any subscriptions, including Pausely Pro. To cancel those, open Settings, tap your name, then Subscriptions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف حسابك وقائمة اشتراكاتك وسجلك نهائيًا من خوادم Pausely ومن هذا الـ iPhone. لن يُلغي أي اشتراكات، بما فيها Pausely Pro. لإلغائها، افتح الإعدادات، واضغط على اسمك، ثم الاشتراكات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden Ihr Konto, Ihre Abo-Liste und Ihr Verlauf dauerhaft von den Servern von Pausely und diesem iPhone gelöscht. Es werden keine Abos gekündigt, auch nicht Pausely Pro. Um diese zu kündigen, öffnen Sie die Einstellungen, tippen Sie auf Ihren Namen und dann auf Abonnements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina para siempre tu cuenta, tu lista de suscripciones y tu historial de los servidores de Pausely y de este iPhone. No cancela ninguna suscripción, incluida Pausely Pro. Para cancelarlas, abre Ajustes, toca tu nombre y luego Suscripciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement votre compte, votre liste d'abonnements et votre historique des serveurs de Pausely et de cet iPhone. Aucun abonnement n'est résilié, y compris Pausely Pro. Pour les résilier, ouvrez Réglages, touchez votre nom, puis Abonnements."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント、サブスクリプション一覧、履歴をPauselyのサーバーとこのiPhoneから完全に削除します。Pausely Proを含むサブスクリプションは解約されません。解約するには「設定」を開き、自分の名前、「サブスクリプション」の順にタップします。"
          }
        }
      }
    },
    "Waiting for Approval": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في انتظار الموافقة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf Genehmigung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando aprobación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d'approbation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認待ち"
          }
        }
      }
    },
    "This purchase needs someone's approval first. Pausely Pro turns on by itself once it's approved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج هذا الشراء إلى موافقة أولًا. سيُفعَّل Pausely Pro تلقائيًا فور الموافقة عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kauf muss erst genehmigt werden. Pausely Pro wird automatisch aktiviert, sobald er genehmigt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compra necesita aprobación primero. Pausely Pro se activará solo en cuanto se apruebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet achat doit d'abord être approuvé. Pausely Pro s'activera tout seul dès qu'il le sera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この購入にはまず承認が必要です。承認されると、Pausely Proは自動的に有効になります。"
          }
        }
      }
    },
    "Purchase Not Confirmed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تأكيد الشراء"
          }
        },
        "de": {
