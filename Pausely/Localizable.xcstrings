    "100% on-device. Photos are read in memory and never saved or sent anywhere.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بالكامل على الجهاز. تُقرأ الصور في الذاكرة ولا تُحفظ ولا تُرسل إلى أي مكان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "100 % auf dem Gerät. Fotos werden im Arbeitsspeicher gelesen und niemals gespeichert oder gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "100 % en el dispositivo. Las fotos se leen en memoria y nunca se guardan ni se envían."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "100 % sur l’appareil. Les photos sont lues en mémoire et ne sont jamais enregistrées ni envoyées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全に端末内で処理。写真はメモリ上で読み取り、保存も送信も行いません。"
          }
        }
      }
    },
