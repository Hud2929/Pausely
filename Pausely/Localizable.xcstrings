    "No renewals have come due yet. Over the year, if Pausely doesn't save you more than its %@, it will tell you to cancel it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يحن موعد أي تجديد بعد. على مدار العام، إذا لم يوفّر لك Pausely أكثر من تكلفته (%@)، فسيخبرك بإلغائه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es stehen noch keine Verlängerungen an. Wenn Pausely Ihnen im Laufe des Jahres nicht mehr spart als %@, empfiehlt es Ihnen zu kündigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no ha vencido ninguna renovación. A lo largo del año, si Pausely no te ahorra más que sus %@, te dirá que lo canceles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun renouvellement n’est encore arrivé. Sur l’année, si Pausely ne vous fait pas économiser plus que ses %@, il vous dira de le résilier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ更新日を迎えたサブスクはありません。1年を通してPauselyが%@以上の節約にならなければ、解約をおすすめします。"
          }
        }
      }
    },
