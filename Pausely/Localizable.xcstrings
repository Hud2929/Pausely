    "Synced to Pausely's servers over an encrypted connection and encrypted at rest. Other accounts can't read it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُزامن مع خوادم Pausely عبر اتصال مشفّر وتُخزَّن مشفّرة. لا تستطيع الحسابات الأخرى قراءتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird über eine verschlüsselte Verbindung mit den Servern von Pausely synchronisiert und verschlüsselt gespeichert. Andere Konten können sie nicht lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sincroniza con los servidores de Pausely mediante una conexión cifrada y se guarda cifrada. Otras cuentas no pueden leerla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisée avec les serveurs de Pausely via une connexion chiffrée et stockée chiffrée. Les autres comptes ne peuvent pas la lire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化された通信でPauselyのサーバーと同期され、暗号化して保存されます。ほかのアカウントからは読めません。"
          }
        }
      }
    },
    "Take a screenshot of Apple Subscriptions or your bank's recurring charges. Pausely reads it on this iPhone and never uploads the image.": {
      "localizations": {
        "ar": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "التقط لقطة شاشة لاشتراكات Apple أو المدفوعات المتكررة في بنكك. يقرأها Pausely على هذا الـ iPad ولا يرفع الصورة أبدًا."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "التقط لقطة شاشة لاشتراكات Apple أو المدفوعات المتكررة في بنكك. يقرأها Pausely على هذا الـ iPhone ولا يرفع الصورة أبدًا."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Machen Sie einen Screenshot Ihrer Apple-Abos oder wiederkehrenden Bankabbuchungen. Pausely liest ihn auf diesem iPad und lädt das Bild niemals hoch."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Machen Sie einen Screenshot Ihrer Apple-Abos oder wiederkehrenden Bankabbuchungen. Pausely liest ihn auf diesem iPhone und lädt das Bild niemals hoch."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Take a screenshot of Apple Subscriptions or your bank's recurring charges. Pausely reads it on this iPad and never uploads the image."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Take a screenshot of Apple Subscriptions or your bank's recurring charges. Pausely reads it on this iPhone and never uploads the image."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "device": {
