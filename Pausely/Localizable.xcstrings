      }
    },
    "Totals are shown in this currency. Each subscription keeps the currency it's charged in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعرض الإجماليات بهذه العملة. يحتفظ كل اشتراك بالعملة التي يُخصم بها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Summen werden in dieser Währung angezeigt. Jedes Abo behält die Währung, in der es abgebucht wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los totales se muestran en esta moneda. Cada suscripción conserva la moneda en la que se cobra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les totaux sont affichés dans cette devise. Chaque abonnement garde la devise dans laquelle il est prélevé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合計はこの通貨で表示されます。各サブスクは請求される通貨のままです。"
          }
        }
      }
    },
    "Up to %lld. Pausely Pro removes the limit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى %lld. يزيل Pausely Pro هذا الحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu %lld. Pausely Pro hebt die Grenze auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta %lld. Pausely Pro elimina el límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à %lld. Pausely Pro supprime la limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件までです。Pausely Proなら上限がなくなります。"
          }
        }
