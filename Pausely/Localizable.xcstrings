    "Auto-renews until canceled. Cancel anytime in App Store Settings.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم التجديد التلقائي حتى الإلغاء. يمكنك الإلغاء في أي وقت من إعدادات App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich automatisch bis zur Kündigung. Jederzeit in den App Store-Einstellungen kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva automáticamente hasta que se cancele. Cancele en cualquier momento en Ajustes de App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvellement automatique jusqu'à annulation. Annulez à tout moment dans les paramètres App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルするまで自動更新されます。App Store設定でいつでもキャンセルできます。"
          }
        }
      }
    },
