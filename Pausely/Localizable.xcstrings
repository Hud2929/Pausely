          }
        }
      }
    },
    "That's %@ you won't pay over the next 12 months. It's on your Savings Receipt.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي %@ لن تدفعها خلال الأشهر الـ 12 القادمة. تمت إضافتها إلى إيصال التوفير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind %@, die Sie in den nächsten 12 Monaten nicht zahlen. Es steht auf Ihrem Sparbeleg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son %@ que no pagarás en los próximos 12 meses. Está en tu recibo de ahorro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soit %@ que vous ne paierez pas au cours des 12 prochains mois. C'est sur votre reçu d'économies."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後12か月で%@を払わずに済みます。節約レシートに記録しました。"
          }
        }
      }
    },
    "It's on your Savings Receipt.": {
      "localizations": {
        "ar": {
