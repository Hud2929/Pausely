    "Subscriptions you add go to your account, like any you type in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاشتراكات التي تضيفها تُحفظ في حسابك، مثل أي اشتراك تكتبه بنفسك."
          }
        },
        "de": {
          "stringUnit": {
