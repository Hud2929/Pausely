    "Pause Plan keeps one streaming service on, pauses the rest, and rotates every month, so you still see everything.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُبقي خطة الإيقاف خدمة بث واحدة نشطة، وتوقف البقية مؤقتًا، وتبدّل كل شهر، فتشاهد كل شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pausenplan lässt einen Streamingdienst aktiv, pausiert die anderen und wechselt jeden Monat, sodass Sie trotzdem alles sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Plan de Pausa mantiene activo un servicio de streaming, pausa el resto y rota cada mes, para que no te pierdas nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan de pause garde un service de streaming actif, met les autres en pause et alterne chaque mois, pour tout voir quand même."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止プランはストリーミングを1つだけ有効にして残りを止め、毎月入れ替えるので、すべての作品を楽しめます。"
          }
        }
      }
    },
