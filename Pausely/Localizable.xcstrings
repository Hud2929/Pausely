    "Usage data never leaves your device. We only store insights to help you save money.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzungsdaten verlassen Ihr Gerät nie. Wir speichern nur Einblicke, um Ihnen beim Sparen zu helfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de uso nunca salen de su dispositivo. Solo almacenamos información para ayudarlo a ahorrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données d'utilisation ne quittent jamais votre appareil. Nous ne stockons que des aperçus pour vous aider à économiser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用データはデバイスから外に出ません。節約に役立つインサイトのみを保存します。"
