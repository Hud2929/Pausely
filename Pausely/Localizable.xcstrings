        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela antes del %@ para que no te cobren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résiliez avant le %@ pour ne pas être prélevé."
          }
        },
        "ja": {
