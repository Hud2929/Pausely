    "At least 8 characters, with a capital letter, a small letter and a number.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "8 أحرف على الأقل، تتضمن حرفًا كبيرًا وحرفًا صغيرًا ورقمًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens 8 Zeichen, mit einem Großbuchstaben, einem Kleinbuchstaben und einer Zahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos 8 caracteres, con una mayúscula, una minúscula y un número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
