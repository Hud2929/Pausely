    "Emails checked: %lld. Receipts may go to another address: add that inbox too.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرسائل التي تم فحصها: %lld. قد تصل الإيصالات إلى عنوان آخر: أضف ذلك البريد أيضًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geprüfte E-Mails: %lld. Belege gehen vielleicht an eine andere Adresse: Fügen Sie auch dieses Postfach hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Correos revisados: %lld. Puede que los recibos lleguen a otra dirección: añade también ese buzón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mails vérifiés : %lld. Les reçus arrivent peut-être à une autre adresse : ajoutez aussi cette boîte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認したメール: %lld件。領収書が別のアドレスに届いている可能性があります。そのメールボックスも追加してください。"
          }
        }
      }
    },
