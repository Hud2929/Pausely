    "Optional 1–5 ratings you submit after cancelling are combined into anonymous averages per service.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُجمع التقييمات الاختيارية من واحد إلى خمسة التي ترسلها بعد الإلغاء في متوسطات مجهولة لكل خدمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale Bewertungen von 1 bis 5 nach einer Kündigung werden anonym pro Dienst gemittelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las valoraciones opcionales del 1 al 5 que envías al cancelar se combinan en promedios anónimos por servicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes facultatives de 1 à 5 envoyées après une résiliation sont regroupées en moyennes anonymes par service."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解約後に任意で送信いただいた1〜5の評価は、サービスごとの匿名平均にまとめられます。"
          }
        }
      }
