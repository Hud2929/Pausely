    "You'll be charged %@. Renews automatically unless you cancel at least 24 hours before the end of the current period in Settings › Subscriptions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم خصم %@. يتجدد تلقائيًا ما لم تقم بالإلغاء قبل أربع وعشرين ساعة على الأقل من نهاية الفترة الحالية في الإعدادات › الاشتراكات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihnen werden %@ berechnet. Verlängert sich automatisch, sofern Sie nicht mindestens 24 Stunden vor Ablauf des aktuellen Zeitraums in Einstellungen › Abonnements kündigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se te cobrará %@. Se renueva automáticamente salvo que canceles al menos 24 horas antes del final del periodo actual en Ajustes › Suscripciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez facturé %@. Renouvellement automatique sauf résiliation au moins 24 heures avant la fin de la période en cours dans Réglages › Abonnements."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が課金されます。現在の期間終了の24時間前までに「設定」›「サブスクリプション」で解約しない限り自動更新されます。"
          }
        }
      }
    },
