    "The email or app password wasn't accepted. Check both and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُقبل البريد الإلكتروني أو كلمة مرور التطبيق. تحقق منهما وحاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail-Adresse oder App-Passwort wurden nicht akzeptiert. Prüfen Sie beides und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se aceptó el correo o la contraseña de aplicación. Revisa ambos e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adresse e-mail ou le mot de passe d'application n'a pas été accepté. Vérifiez les deux et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスまたはアプリパスワードが受け付けられませんでした。両方を確認して、もう一度お試しください。"
          }
        }
      }
    },
    "The mail server asked Pausely to slow down. Try again in a few minutes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب خادم البريد من Pausely الإبطاء. حاول مجددًا بعد بضع دقائق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mailserver hat Pausely gebeten, langsamer zu machen. Versuchen Sie es in ein paar Minuten erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de correo pidió a Pausely que vaya más despacio. Inténtalo de nuevo en unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de messagerie a demandé à Pausely de ralentir. Réessayez dans quelques minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールサーバーから処理を遅くするよう求められました。数分後にもう一度お試しください。"
          }
        }
      }
    },
    "The mail server said: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قال خادم البريد: %@"
          }
        },
