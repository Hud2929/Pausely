                "stringUnit": {
                  "state": "translated",
                  "value": "ホームの「+」からカタログを選ぶか、このiPhoneでスクリーンショットから読み込むか、「自分で追加」をタップします。"
                }
              }
            }
          }
        }
      }
    },
    "Tap Cancel Subscription. You may need to scroll down to find it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على «إلغاء الاشتراك». قد تحتاج إلى التمرير للأسفل للعثور عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf „Abo kündigen“. Eventuell müssen Sie dafür nach unten scrollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Cancelar Suscripción. Puede que tengas que desplazarte hacia abajo para encontrarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Annuler l'abonnement. Vous devrez peut-être faire défiler l'écran pour le trouver."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「サブスクをキャンセル」をタップします。下にスクロールしないと表示されない場合があります。"
          }
        }
      }
    },
    "Tap Subscriptions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الاشتراكات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf „Abonnements“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Suscripciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Abonnements."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「サブスクリプション」をタップします。"
          }
        }
      }
    },
    "Tap a row to select or unselect. Tap any price to edit it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على أي صف لتحديده أو إلغاء تحديده. انقر على أي سعر لتعديله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf eine Zeile zum Aus- oder Abwählen. Tippen Sie auf einen Preis, um ihn zu bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una fila para seleccionarla o quitarla. Toca cualquier precio para editarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une ligne pour la sélectionner ou la désélectionner. Touchez un prix pour le modifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行をタップして選択・解除できます。料金をタップすると編集できます。"
          }
        }
      }
    },
    "Terms and privacy": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشروط والخصوصية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedingungen und Datenschutz"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Términos y privacidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditions et confidentialité"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "規約とプライバシー"
          }
        }
      }
    },
    "Terms of Service": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شروط الخدمة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzungsbedingungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Términos del servicio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditions d'utilisation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用規約"
          }
        }
      }
    },
    "Thank you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكرًا لكم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vielen Dank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muchas gracias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よろしくお願いいたします。"
          }
        }
      }
    },
    "That code didn't work. Check it, or send a new one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم ينجح هذا الرمز. تحقّق منه أو أرسل رمزًا جديدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code hat nicht funktioniert. Prüfen Sie ihn oder lassen Sie sich einen neuen senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código no funcionó. Compruébalo o envía uno nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code n’a pas fonctionné. Vérifiez-le ou envoyez-en un nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードは使えませんでした。確認するか、新しいコードを送信してください。"
          }
        }
      }
    },
    "That date is in the future. Please check your date of birth.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا التاريخ في المستقبل. يرجى التحقق من تاريخ ميلادك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Datum liegt in der Zukunft. Bitte prüfen Sie Ihr Geburtsdatum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa fecha está en el futuro. Revisa tu fecha de nacimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette date est dans le futur. Veuillez vérifier votre date de naissance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その日付は未来の日付です。生年月日をご確認ください。"
          }
        }
      }
    },
    "That email address doesn't look right. Check it and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان البريد الإلكتروني لا يبدو صحيحًا. تحقّق منه وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese E-Mail-Adresse sieht nicht richtig aus. Prüfen Sie sie und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa dirección de correo no parece correcta. Revísala e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse e-mail ne semble pas correcte. Vérifiez-la et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスが正しくないようです。確認して、もう一度お試しください。"
          }
        }
      }
    },
    "That email and password don't match an account. Check them, or reset your password.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البريد وكلمة المرور لا يطابقان أي حساب. تحقّق منهما أو أعد تعيين كلمة المرور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese E-Mail-Adresse und dieses Passwort passen zu keinem Konto. Prüfen Sie beides oder setzen Sie Ihr Passwort zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese correo y esa contraseña no coinciden con ninguna cuenta. Revísalos o restablece tu contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse e-mail et ce mot de passe ne correspondent à aucun compte. Vérifiez-les ou réinitialisez votre mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメールアドレスとパスワードに一致するアカウントがありません。確認するか、パスワードを再設定してください。"
          }
        }
      }
    },
    "That is more than Pausely can track.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا أكثر مما يستطيع Pausely متابعته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist mehr, als Pausely erfassen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es más de lo que Pausely puede seguir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est plus que ce que Pausely peut suivre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausely で扱える金額を超えています。"
          }
        }
      }
    },
    "That link has expired or was already used. Ask for a new one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية هذا الرابط أو سبق استخدامه. اطلب رابطًا جديدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link ist abgelaufen oder wurde schon verwendet. Fordern Sie einen neuen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese enlace ha caducado o ya se usó. Pide uno nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien a expiré ou a déjà été utilisé. Demandez-en un nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクは期限切れか、すでに使用されています。新しいものをリクエストしてください。"
          }
        }
      }
    },
    "That port number isn't valid.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رقم المنفذ هذا غير صالح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Portnummer ist ungültig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese número de puerto no es válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce numéro de port n'est pas valide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのポート番号は無効です。"
          }
        }
      }
    },
    "That was too soon after the last email. Wait a minute and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يمضِ وقت كافٍ منذ آخر رسالة. انتظر دقيقة ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das war zu kurz nach der letzten E-Mail. Warten Sie eine Minute und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha pasado muy poco desde el último correo. Espera un minuto e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’était trop tôt après le dernier e-mail. Patientez une minute et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のメールから時間が経っていません。1分待ってからもう一度お試しください。"
          }
        }
      }
    },
    "That's %@ a year": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي %@ سنويًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind %@ pro Jahr"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son %@ al año"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soit %@ par an"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年間%@です"
          }
        }
      }
    },
    "That's %@ a year (about %@)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي %1$@ سنويًا (نحو %2$@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind %1$@ pro Jahr (ca. %2$@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son %1$@ al año (unos %2$@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soit %1$@ par an (environ %2$@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年間%1$@（約%2$@）です"
          }
        }
      }
    },
    "That's %@ a year. Pausely asks before each renewal whether it's still worth it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا %@ في السنة. يسألك Pausely قبل كل تجديد إن كان الاشتراك ما زال يستحق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind %@ im Jahr. Pausely fragt vor jeder Verlängerung, ob es sich noch lohnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son %@ al año. Pausely te pregunta antes de cada renovación si sigue valiendo la pena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela fait %@ par an. Pausely vous demande avant chaque renouvellement si cela en vaut encore la peine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年間%@です。Pauselyは更新のたびに、まだ必要かどうかを確認します。"
          }
        }
      }
    },
    "That's %@ you won't pay over the next 12 months. It's on your Savings Receipt.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي %@ لن تدفعها خلال الأشهر الاثني عشر القادمة. تمت إضافتها إلى إيصال التوفير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind %@, die Sie in den nächsten 12 Monaten nicht zahlen. Es steht auf Ihrem Sparbeleg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son %@ que no pagarás en los próximos 12 meses. Está en tu recibo de ahorro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soit %@ que vous ne paierez pas au cours des 12 prochains mois. C'est sur votre reçu d'économies."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後12か月で%@を払わずに済みます。節約レシートに記録しました。"
          }
        }
      }
    },
    "That's about %@ a year more than you thought.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يزيد بنحو %@ في السنة عمّا ظننت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind etwa %@ im Jahr mehr, als Sie dachten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son unos %@ al año más de lo que pensabas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela fait environ %@ par an de plus que vous ne pensiez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "思っていたより年間約%@多く払っています。"
          }
        }
      }
    },
    "That's my guess": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا تخميني"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist meine Schätzung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa es mi estimación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est mon estimation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これが私の予想"
          }
        }
      }
    },
    "That's the password this account already has. Choose a different one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه هي كلمة المرور الحالية لهذا الحساب. اختر كلمة مختلفة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Passwort hat das Konto bereits. Wählen Sie ein anderes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa es la contraseña que ya tiene esta cuenta. Elige otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est déjà le mot de passe de ce compte. Choisissez-en un autre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントで現在使われているパスワードです。別のパスワードを選んでください。"
          }
        }
      }
    },
    "The App Store couldn't be reached. Try again in a moment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى App Store. حاول مجددًا بعد قليل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store war nicht erreichbar. Versuchen Sie es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con el App Store. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre l'App Store. Réessayez dans un instant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeに接続できませんでした。しばらくしてからもう一度お試しください。"
          }
        }
      }
    },
    "The App Store couldn't confirm this purchase. If you were charged, tap Restore purchases.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على App Store تأكيد هذا الشراء. إذا تم خصم المبلغ، اضغط على «استعادة المشتريات»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store konnte diesen Kauf nicht bestätigen. Falls Ihnen etwas berechnet wurde, tippen Sie auf „Käufe wiederherstellen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store no pudo confirmar esta compra. Si se te cobró, toca Restaurar compras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store n'a pas pu confirmer cet achat. Si vous avez été débité, touchez Restaurer les achats."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeでこの購入を確認できませんでした。請求された場合は「購入を復元」をタップしてください。"
          }
        }
      }
    },
    "The App Store didn't complete it. Check your connection and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُكمل App Store العملية. تحقق من اتصالك وحاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store hat ihn nicht abgeschlossen. Prüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store no la completó. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store ne l'a pas finalisé. Vérifiez votre connexion et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeで処理が完了しませんでした。接続を確認して、もう一度お試しください。"
          }
        }
      }
    },
    "The Pausely Promise": {
