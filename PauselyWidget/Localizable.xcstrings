{
  "sourceLanguage": "en",
  "strings": {
    "Add renewal dates in Pausely to see what's next": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف تواريخ التجديد في Pausely لمعرفة ما التالي"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tragen Sie in Pausely Verlängerungsdaten ein, um zu sehen, was als Nächstes kommt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade fechas de renovación en Pausely para ver qué viene"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des dates de renouvellement dans Pausely pour voir la suite"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauselyで更新日を追加すると、次の請求が表示されます"
          }
        }
      }
    },
    "Add what you pay for in Pausely": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف ما تدفع مقابله في Pausely"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge in Pausely hinzu, wofür du zahlst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade en Pausely lo que pagas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez dans Pausely ce que vous payez"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払っているものをPauselyに追加"
          }
        }
      }
    },
    "Cloud storage": {
