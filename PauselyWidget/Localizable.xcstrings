    },
    "Money kept from cancelled subscriptions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأموال التي وفّرتها من الاشتراكات الملغاة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld, das Sie durch gekündigte Abos behalten haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinero ahorrado de suscripciones canceladas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’argent gardé grâce aux abonnements résiliés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解約したサブスクで節約できた金額です。"
          }
        }
