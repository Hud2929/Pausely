    "What charges next, and when.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الذي سيُخصم تاليًا، ومتى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was als Nächstes abgebucht wird, und wann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué se cobra después, y cuándo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui sera prélevé ensuite, et quand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に請求されるものと、その日付。"
          }
        }
      }
    },
    "Cancel a subscription to start your receipt": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألغِ اشتراكًا ليبدأ إيصال التوفير"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kündigen Sie ein Abo für Ihren Sparbeleg"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela una suscripción para iniciar tu recibo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résiliez un abonnement pour démarrer votre reçu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクを解約すると節約レシートが始まります"
          }
        }
      }
    },
    "Kept so far": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما وفّرته حتى الآن"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisher behalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahorrado hasta ahora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Économisé jusqu’ici"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまでの節約額"
          }
        }
